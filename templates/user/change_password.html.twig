{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe - EventHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .change-password-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }
        
        .change-password-header {
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
            color: white;
            padding: 3rem 2rem;
            border-radius: 30px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(8, 12, 26, 0.2);
        }
        
        .change-password-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 2px,
                rgba(255,255,255,0.03) 2px,
                rgba(255,255,255,0.03) 4px
            );
            animation: movePattern 20s linear infinite;
        }
        
        @keyframes movePattern {
            0% { transform: translateX(-100px) translateY(-100px); }
            100% { transform: translateX(100px) translateY(100px); }
        }
        
        .header-content {
            position: relative;
            z-index: 2;
            text-align: center;
        }
        
        .header-content h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0 0 1rem 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        
        .header-content p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin: 0;
        }
        
        .form-section {
            background: white;
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .form-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #dc3545, #e74c3c);
        }
        
        .form-group {
            margin-bottom: 2rem;
        }
        
        .form-label {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 15px;
            padding: 1rem 1.5rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8f9fa;
            width: 100%;
        }
        
        .form-control:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
            background: white;
            outline: none;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
            border: none;
            padding: 1rem 2.5rem;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1rem;
            color: white;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(220, 53, 69, 0.4);
            background: linear-gradient(135deg, #c82333 0%, #dc3545 100%);
        }

        .btn-secondary {
            background: transparent;
            border: 2px solid #6c757d;
            color: #6c757d;
            padding: 1rem 2rem;
            border-radius: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-secondary:hover {
            background: #6c757d;
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
        }
        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
        }
        .back-button {
            background: rgba(255,255,255,0.95);
            color: #2c3e50;
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 2rem;
        }
        
        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
            color: #dc3545;
            text-decoration: none;
        }
        
        .alert {
            border-radius: 15px;
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            border: none;
        }
        
        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
        
        .password-requirements {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-left: 4px solid #28a745;
        }
        
        .password-requirements h6 {
            color: #2c3e50;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .password-requirements ul {
            margin: 0;
            padding-left: 1rem;
        }
        
        .password-requirements li {
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        @media (max-width: 768px) {
            .change-password-container {
                padding: 1rem;
            }
            
            .change-password-header {
                padding: 2rem 1.5rem;
                border-radius: 20px;
            }
            
            .header-content h1 {
                font-size: 2rem;
            }
            
            .form-section {
                padding: 2rem;
            }
            
            .form-actions {
                flex-direction: column;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="change-password-container">
        <div class="container">
            <!-- En-tête -->
            <div class="change-password-header">
                <div class="header-content">
                    <h1>
                        <i class="fas fa-key me-3"></i>
                        Modifier le mot de passe
                    </h1>
                    <p>Choisissez un nouveau mot de passe sécurisé pour votre compte</p>
                </div>
            </div>
            
            <!-- Formulaire -->
            <div class="form-section">
                <!-- Messages d'erreur globaux -->
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {{ message }}
                    </div>
                {% endfor %}
                
                <!-- Messages d'erreur du formulaire -->
                {% for error in form.plainPassword.vars.errors %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {{ error.message }}
                    </div>
                {% endfor %}
                
                <!-- Erreurs des champs individuels -->
                {% for error in form.plainPassword.first.vars.errors %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {{ error.message }}
                    </div>
                {% endfor %}
                
                {% for error in form.plainPassword.second.vars.errors %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {{ error.message }}
                    </div>
                {% endfor %}
                
                <!-- Exigences du mot de passe (simplifiées pour debug) -->
                <div class="password-requirements">
                    <h6>
                        <i class="fas fa-shield-alt"></i>
                        Exigences du mot de passe (temporairement simplifiées)
                    </h6>
                    <ul>
                        <li>Au moins 6 caractères</li>
                        <li>Les deux mots de passe doivent être identiques</li>
                    </ul>
                </div>
                
                {{ form_start(form) }}
                    <div class="form-group">
                        {{ form_label(form.plainPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.first, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Entrez votre nouveau mot de passe'
                            }
                        }) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(form.plainPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.second, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Confirmez votre nouveau mot de passe'
                            }
                        }) }}
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>
                            Modifier le mot de passe
                        </button>
                        <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>
                            Annuler
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
            
            <!-- Bouton retour en bas de page -->
            <div class="text-center">
                <a href="{{ path('app_profile') }}" class="back-button">
                    <i class="fas fa-arrow-left me-2"></i>
                    Retour au profil
                </a>
            </div>
        </div>
    </div>
{% endblock %}
