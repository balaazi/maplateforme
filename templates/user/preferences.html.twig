{% extends 'base.html.twig' %}

{% block title %}Préférences de notification{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Préférences de notification</h2>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h3>Notifications par e-mail</h3>
                        <p class="text-muted">Gérez vos préférences de notification par e-mail.</p>
                        
                        <div class="d-flex align-items-center mb-3">
                            <div class="me-3">
                                {% if user.notifyByEmail %}
                                    <span class="badge bg-success">Activées</span>
                                {% else %}
                                    <span class="badge bg-danger">Désactivées</span>
                                {% endif %}
                            </div>
                            
                            {% if user.notifyByEmail %}
                                <a href="{{ path('disable_email_notifications') }}" class="btn btn-danger">
                                    <i class="fas fa-bell-slash"></i> Désactiver les notifications
                                </a>
                            {% else %}
                                <a href="{{ path('enable_email_notifications') }}" class="btn btn-success">
                                    <i class="fas fa-bell"></i> Activer les notifications
                                </a>
                            {% endif %}
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            {% if user.notifyByEmail %}
                                Vous recevrez des notifications par e-mail pour :
                                <ul class="mb-0">
                                    <li>Les invitations expirées</li>
                                    <li>Les rappels d'événements</li>
                                    <li>Les modifications importantes</li>
                                </ul>
                            {% else %}
                                Vous ne recevrez pas de notifications par e-mail. Vous pouvez toujours consulter vos notifications sur la plateforme.
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="{{ path('event_list') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour aux événements
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}