<!-- Contenu principal -->
<main class="container py-5">
    {% block body %}{% endblock %}
</main>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}
    <script src="{{ asset('js/app.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navbar = document.getElementById('mainNavbar');
            const pageLoader = document.querySelector('.page-loader');

            // Supprimer le loader après animation
            setTimeout(() => {
                if (pageLoader) {
                    pageLoader.remove();
                }
            }, 2000);

            // Effet de scroll premium
            let lastScrollTop = 0;
            window.addEventListener('scroll', function() {
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                
                if (scrollTop > 50) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }

                // Auto-hide navbar en scrollant vers le bas (optionnel)
                if (scrollTop > lastScrollTop && scrollTop > 200) {
                    navbar.style.transform = 'translateY(-100%)';
                } else {
                    navbar.style.transform = 'translateY(0)';
                }
                lastScrollTop = scrollTop;
            });

            // Animation des icônes dans les dropdowns
            const dropdownItems = document.querySelectorAll('.dropdown-item');
            dropdownItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    const icon = this.querySelector('i');
                    if (icon) {
                        icon.style.transform = 'scale(1.2) rotate(5deg)';
                        icon.style.transition = 'all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    }
                });
                
                item.addEventListener('mouseleave', function() {
                    const icon = this.querySelector('i');
                    if (icon) {
                        icon.style.transform = 'scale(1) rotate(0deg)';
                    }
                });
            });

            // Effet de parallaxe pour les particules
            window.addEventListener('mousemove', function(e) {
                const particles = document.querySelectorAll('.particle');
                const mouseX = e.clientX / window.innerWidth;
                const mouseY = e.clientY / window.innerHeight;

                particles.forEach((particle, index) => {
                    const speed = (index + 1) * 0.5;
                    const x = mouseX * speed;
                    const y = mouseY * speed;
                    particle.style.transform += ` translate(${x}px, ${y}px)`;
                });
            });

            // Animation des liens de navigation
            const navLinks = document.querySelectorAll('.nav-link:not(.dropdown-toggle)');
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    // Effet de ripple
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;
                    
                    ripple.style.cssText = `
                        position: absolute;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.6);
                        width: ${size}px;
                        height: ${size}px;
                        left: ${x}px;
                        top: ${y}px;
                        animation: ripple 0.6s linear;
                        pointer-events: none;
                        z-index: 0;
                    `;
                    
                    this.style.position = 'relative';
                    this.appendChild(ripple);
                    
                    setTimeout(() => {
                        ripple.remove();
                    }, 600);
                });
            });

            // Ajout de l'animation ripple CSS
            const style = document.createElement('style');
            style.textContent = `
                @keyframes ripple {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);

            // Détection de la page active
            const currentPath = window.location.pathname;
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });

            // Animation au focus pour accessibilité
            const focusableElements = document.querySelectorAll('.nav-link, .dropdown-item, .btn');
            focusableElements.forEach(element => {
                element.addEventListener('focus', function() {
                    this.style.outline = '3px solid rgba(102, 126, 234, 0.5)';
                    this.style.outlineOffset = '2px';
                });
                
                element.addEventListener('blur', function() {
                    this.style.outline = 'none';
                });
            });

            // Système de notifications en temps réel
            {% if app.user %}
            let notificationUpdateInterval;
            const notificationBadge = document.getElementById('notification-badge');
            const notificationContent = document.getElementById('notification-content');
            const markAllReadBtn = document.getElementById('mark-all-read-btn');

            // Fonction pour mettre à jour le badge
            function updateNotificationBadge(count) {
                if (count > 0) {
                    notificationBadge.textContent = count > 99 ? '99+' : count;
                    notificationBadge.style.display = 'flex';
                    notificationBadge.classList.add('notification-badge');
                } else {
                    notificationBadge.style.display = 'none';
                }
            }

            // Fonction pour récupérer les notifications
            async function fetchNotifications() {
                try {
                    const response = await fetch('/api/notifications/list');
                    const data = await response.json();
                    return data.notifications || [];
                } catch (error) {
                    console.error('Erreur lors de la récupération des notifications:', error);
                    return [];
                }
            }

            // Fonction pour récupérer le nombre de notifications non lues
            async function fetchNotificationCount() {
                try {
                    const response = await fetch('/api/notifications/count');
                    const data = await response.json();
                    return data.count || 0;
                } catch (error) {
                    console.error('Erreur lors de la récupération du nombre de notifications:', error);
                    return 0;
                }
            }

            // Fonction pour afficher les notifications dans le dropdown
            function displayNotifications(notifications) {
                if (!notifications || notifications.length === 0) {
                    notificationContent.innerHTML = `
                        <div class="notification-empty">
                            <i class="fas fa-bell-slash"></i>
                            <div>Aucune notification récente</div>
                        </div>
                    `;
                    markAllReadBtn.style.display = 'none';
                    return;
                }

                const hasUnread = notifications.some(n => !n.isRead);
                markAllReadBtn.style.display = hasUnread ? 'block' : 'none';

                notificationContent.innerHTML = notifications
                    .slice(0, 10) // Limiter à 10 notifications récentes
                    .map(notification => {
                        const timeAgo = getTimeAgo(new Date(notification.createdAt));
                        const typeIcon = getTypeIcon(notification.type);
                        
                        return `
                            <div class="notification-item ${!notification.isRead ? 'unread' : ''}" data-id="${notification.id}">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="${typeIcon}" style="color: var(--primary-color); margin-top: 0.2rem;"></i>
                                    <div class="flex-grow-1">
                                        <div class="notification-title">${notification.title || 'Notification'}</div>
                                        <div class="notification-message">${notification.message}</div>
                                        <div class="notification-time">
                                            <i class="fas fa-clock"></i>
                                            ${timeAgo}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
            }

            // Fonction pour obtenir l'icône selon le type
            function getTypeIcon(type) {
                const icons = {
                    'event_reminder': 'fas fa-clock',
                    'event_update': 'fas fa-edit',
                    'event_cancel': 'fas fa-times-circle',
                    'invitation': 'fas fa-envelope',
                    'welcome': 'fas fa-hand-wave',
                    'info': 'fas fa-info-circle'
                };
                return icons[type] || 'fas fa-bell';
            }

            // Fonction pour calculer le temps écoulé
            function getTimeAgo(date) {
                const now = new Date();
                const diff = now - date;
                const minutes = Math.floor(diff / 60000);
                const hours = Math.floor(diff / 3600000);
                const days = Math.floor(diff / 86400000);

                if (days > 0) return `${days}j`;
                if (hours > 0) return `${hours}h`;
                if (minutes > 0) return `${minutes}min`;
                return 'Maintenant';
            }

            // Fonction principale de mise à jour
            async function updateNotifications() {
                const count = await fetchNotificationCount();
                updateNotificationBadge(count);
            }

            // Charger les notifications lors de l'ouverture du dropdown
            document.getElementById('notificationDropdown').addEventListener('click', async function(e) {
                if (e.target === this || this.contains(e.target)) {
                    notificationContent.innerHTML = `
                        <div class="p-3 text-center text-muted">
                            <i class="fas fa-spinner fa-spin"></i>
                            Chargement...
                        </div>
                    `;
                    
                    const notifications = await fetchNotifications();
                    displayNotifications(notifications);
                }
            });

            // Marquer toutes les notifications comme lues
            markAllReadBtn.addEventListener('click', async function() {
                try {
                    const response = await fetch('/api/notifications/mark-all-read', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    });
                    
                    if (response.ok) {
                        this.style.display = 'none';
                        
                        // Recharger les notifications
                        const notifications = await fetchNotifications();
                        displayNotifications(notifications);
                        await updateNotifications();
                        
                        // Afficher une notification de succès
                        showToast('Toutes les notifications ont été marquées comme lues', 'success');
                    }
                } catch (error) {
                    console.error('Erreur lors de la mise à jour:', error);
                    showToast('Erreur lors de la mise à jour', 'error');
                }
            });

            // Fonction pour afficher des toasts
            function showToast(message, type = 'info') {
                const toast = document.createElement('div');
                toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
                toast.setAttribute('role', 'alert');
                toast.setAttribute('aria-live', 'assertive');
                toast.setAttribute('aria-atomic', 'true');
                
                toast.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fas fa-${type === 'success' ? 'check' : 'exclamation-triangle'}"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                `;
                
                const toastContainer = document.querySelector('.toast-container') || createToastContainer();
                toastContainer.appendChild(toast);
                
                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
                
                // Supprimer le toast après 5 secondes
                setTimeout(() => {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                }, 5000);
            }

            function createToastContainer() {
                const container = document.createElement('div');
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                document.body.appendChild(container);
                return container;
            }

            // Variables pour le système de rappels
            let reminderCheckInterval;
            let lastReminderCheck = 0;
            let audioContext;
            let soundEnabled = localStorage.getItem('soundEnabled') !== 'false';
            let reminderQueue = [];
            
            // Initialiser le système audio
            function initializeAudio() {
                try {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    console.warn('Audio context not supported:', e);
                }
            }

            // Fonction pour jouer un son
            function playNotificationSound(soundFile, volume = 0.5) {
                if (!soundEnabled || !soundFile) return;
                
                try {
                    const audio = new Audio(soundFile);
                    audio.volume = volume;
                    audio.play().catch(e => console.warn('Couldn\'t play sound:', e));
                } catch (e) {
                    console.warn('Error playing sound:', e);
                }
            }

            // Fonction pour créer une notification visuelle avancée
            function createAdvancedNotification(notificationData) {
                const config = notificationData.config || {};
                const style = config.style || {};
                
                // Créer le conteneur de notification
                const notification = document.createElement('div');
                notification.className = 'advanced-notification';
                notification.id = notificationData.id;
                
                // Appliquer les styles
                Object.assign(notification.style, {
                    position: 'fixed',
                    top: '20px',
                    right: '20px',
                    minWidth: '300px',
                    maxWidth: '400px',
                    backgroundColor: style.backgroundColor || '#6c757d',
                    color: style.textColor || '#ffffff',
                    border: `2px solid ${style.borderColor || '#545b62'}`,
                    borderRadius: '15px',
                    padding: '15px',
                    boxShadow: style.boxShadow || '0 10px 30px rgba(0,0,0,0.3)',
                    zIndex: '9999',
                    animation: style.animation ? `${style.animation} 1s ease-in-out` : 'slideInRight 0.5s ease-out',
                    backdropFilter: 'blur(10px)',
                    fontFamily: 'Segoe UI, system-ui, sans-serif'
                });
                
                // Contenu HTML
                notification.innerHTML = `
                    <div style="display: flex; align-items: flex-start; gap: 12px;">
                        <div style="flex-shrink: 0;">
                            <i class="${style.icon || 'fas fa-bell'}" style="font-size: 24px; color: ${style.textColor || '#ffffff'};"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <div style="font-weight: bold; font-size: 16px; margin-bottom: 5px;">${notificationData.title}</div>
                            <div style="font-size: 14px; line-height: 1.4; margin-bottom: 10px;">${notificationData.message}</div>
                            ${notificationData.event ? `
                                <div style="font-size: 12px; opacity: 0.9; margin-bottom: 10px;">
                                    📅 ${notificationData.event.title}<br>
                                    🕒 ${new Date(notificationData.event.date).toLocaleString('fr-FR')}<br>
                                    📍 ${notificationData.event.location}
                                </div>
                            ` : ''}
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                ${notificationData.actions.dismiss ? '<button class="notif-btn dismiss-btn" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: inherit; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;">Ignorer</button>' : ''}
                                ${notificationData.actions.snooze ? '<button class="notif-btn snooze-btn" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: inherit; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;">Reporter (5min)</button>' : ''}
                                ${notificationData.actions.viewEvent && notificationData.event ? '<button class="notif-btn view-btn" style="background: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.4); color: inherit; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;">Voir l\'événement</button>' : ''}
                            </div>
                        </div>
                        <div style="flex-shrink: 0;">
                            <button class="close-notif" style="background: none; border: none; color: inherit; cursor: pointer; font-size: 20px; opacity: 0.7; padding: 0; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">&times;</button>
                        </div>
                    </div>
                `;
                
                // Ajouter les gestionnaires d'événements
                const dismissBtn = notification.querySelector('.dismiss-btn');
                const snoozeBtn = notification.querySelector('.snooze-btn');
                const viewBtn = notification.querySelector('.view-btn');
                const closeBtn = notification.querySelector('.close-notif');
                
                if (dismissBtn) {
                    dismissBtn.addEventListener('click', () => dismissNotification(notification));
                }
                
                if (snoozeBtn) {
                    snoozeBtn.addEventListener('click', () => snoozeNotification(notificationData, notification));
                }
                
                if (viewBtn && notificationData.event) {
                    viewBtn.addEventListener('click', () => {
                        window.location.href = `/event/${notificationData.event.id}`;
                    });
                }
                
                if (closeBtn) {
                    closeBtn.addEventListener('click', () => dismissNotification(notification));
                }
                
                // Ajouter au DOM
                document.body.appendChild(notification);
                
                // Jouer le son si configuré
                if (config.playSound && config.soundFile) {
                    playNotificationSound(config.soundFile);
                }
                
                // Auto-dismiss après la durée configurée
                const duration = config.duration || 5000;
                setTimeout(() => {
                    if (document.body.contains(notification)) {
                        dismissNotification(notification);
                    }
                }, duration);
                
                return notification;
            }

            // Fonction pour ignorer une notification
            function dismissNotification(notificationElement) {
                notificationElement.style.animation = 'slideOutRight 0.3s ease-in';
                setTimeout(() => {
                    if (document.body.contains(notificationElement)) {
                        document.body.removeChild(notificationElement);
                    }
                }, 300);
            }

            // Fonction pour reporter une notification
            function snoozeNotification(notificationData, notificationElement) {
                dismissNotification(notificationElement);
                
                // Reporter de 5 minutes
                setTimeout(() => {
                    const snoozedData = {...notificationData};
                    snoozedData.id = uniqid('snoozed_');
                    snoozedData.title = '⏰ ' + snoozedData.title + ' (Reporté)';
                    createAdvancedNotification(snoozedData);
                }, 5 * 60 * 1000); // 5 minutes
                
                showToast('Notification reportée de 5 minutes', 'info');
            }

            // Fonction pour générer un ID unique
            function uniqid(prefix = '') {
                return prefix + Date.now().toString(36) + Math.random().toString(36).substr(2);
            }

            // Fonction pour vérifier les rappels en temps réel
            async function checkReminders() {
                try {
                    const response = await fetch('/api/reminders/check');
                    const data = await response.json();
                    
                    if (data.success && data.data.pending_notifications.length > 0) {
                        // Traiter chaque notification en attente
                        data.data.pending_notifications.forEach(notification => {
                            createAdvancedNotification(notification);
                        });
                        
                        // Mettre à jour le badge si il y a des notifications urgentes
                        if (data.data.has_urgent) {
                            const badge = document.getElementById('notification-badge');
                            if (badge) {
                                badge.style.animation = 'pulse-urgent 1s infinite';
                                badge.style.backgroundColor = '#dc3545';
                            }
                        }
                    }
                } catch (error) {
                    console.error('Erreur lors de la vérification des rappels:', error);
                }
            }



            // Ajouter les styles CSS pour les animations
            const advancedNotificationStyles = document.createElement('style');
            advancedNotificationStyles.textContent = `
                @keyframes slideInRight {
                    from {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                    to {
                        transform: translateX(0);
                        opacity: 1;
                    }
                }
                
                @keyframes slideOutRight {
                    from {
                        transform: translateX(0);
                        opacity: 1;
                    }
                    to {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                }
                
                @keyframes pulse-urgent {
                    0%, 100% {
                        transform: scale(1);
                        opacity: 1;
                    }
                    50% {
                        transform: scale(1.1);
                        opacity: 0.8;
                    }
                }
                
                .advanced-notification .notif-btn:hover {
                    background: rgba(255,255,255,0.4) !important;
                    transform: translateY(-1px);
                }
                
                .advanced-notification .close-notif:hover {
                    opacity: 1 !important;
                    transform: scale(1.1);
                }
            `;
            document.head.appendChild(advancedNotificationStyles);

            // Initialiser le système
            initializeAudio();
            
            // Démarrer le système de notifications existant
            updateNotifications();
            
            // Démarrer la vérification des rappels (plus fréquente)
            checkReminders();
            reminderCheckInterval = setInterval(checkReminders, 10000); // Toutes les 10 secondes
            
            // Mettre à jour les notifications normales toutes les 30 secondes
            notificationUpdateInterval = setInterval(updateNotifications, 30000);

            // Nettoyer les intervalles avant de quitter la page
            window.addEventListener('beforeunload', function() {
                if (notificationUpdateInterval) {
                    clearInterval(notificationUpdateInterval);
                }
                if (reminderCheckInterval) {
                    clearInterval(reminderCheckInterval);
                }
            });

            const badge = document.getElementById('notification-badge');
            function updateNotifBadge() {
                fetch('/api/notifications/count')
                    .then(response => response.json())
                    .then(data => {
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline-flex';
                        } else {
                            badge.textContent = 0;
                            badge.style.display = 'none';
                        }
                    });
            }
            if (badge) {
                updateNotifBadge();
                setInterval(updateNotifBadge, 30000); // rafraîchit toutes les 30s
            }


            {% endif %}
        });
    </script>
{% endblock %}
</body>
</html>
