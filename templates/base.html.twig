<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="{{ asset('images/eventhub-favicon.svg') }}" type="image/svg+xml">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('css/modern-design.css') }}">
        <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') }}">
        <link rel="stylesheet" href="{{ asset('css/forms-modern.css') }}">
        <link rel="stylesheet" href="{{ asset('css/tables-modern.css') }}">
        <style>
            :root {
                --primary-color: #667eea;
                --primary-dark: #764ba2;
                --primary-light: #f093fb;
                --success-color: #2ecc71;
                --danger-color: #e74c3c;
                --text-color: #2d3748;
                --bg-color: #f8fafc;
                --white: #ffffff;
                --gray-100: #f8f9fa;
                --gray-200: #e9ecef;
                --gray-600: #6c757d;
                --gray-700: #495057;
                --gray-800: #343a40;
                --gray-900: #212529;
            }

            body {
                background: var(--bg-color);
                color: var(--text-color);
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                padding-top: 90px; /* Espace pour navbar fixed */
            }

            /* Navbar Container avec effets avancés */
            .navbar {
                background: rgba(255, 255, 255, 0.95) !important;
                backdrop-filter: blur(30px) saturate(150%);
                -webkit-backdrop-filter: blur(30px) saturate(150%);
                border-bottom: 1px solid rgba(102, 126, 234, 0.1);
                padding: 1rem 0;
                transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                position: fixed !important;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1030;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
            }

            .navbar.scrolled {
                padding: 0.5rem 0;
                background: rgba(255, 255, 255, 0.98) !important;
                backdrop-filter: blur(40px) saturate(200%);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
                border-bottom: 1px solid rgba(102, 126, 234, 0.2);
            }

            /* Brand/Logo spectaculaire */
            .navbar-brand {
                font-size: 1.75rem;
                font-weight: 900;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 50%, var(--primary-light) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                position: relative;
                display: flex !important;
                align-items: center;
                text-decoration: none;
                gap: 0.5rem;
            }

            .navbar-brand:hover {
                transform: translateY(-2px) scale(1.05);
                filter: drop-shadow(0 5px 15px rgba(102, 126, 234, 0.3));
                -webkit-text-fill-color: transparent;
            }

            .brand-icon {
                width: 45px;
                height: 45px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1.3rem;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
            }

            .brand-icon img {
                width: 30px;
                height: 30px;
                filter: brightness(0) invert(1);
                transition: all 0.3s ease;
            }

            .brand-icon::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
                transition: left 0.6s ease;
            }

            .navbar-brand:hover .brand-icon::before {
                left: 100%;
            }

            .navbar-brand:hover .brand-icon {
                transform: rotate(10deg) scale(1.1);
                box-shadow: 0 12px 35px rgba(102, 126, 234, 0.4);
            }

            /* Navigation Links modernes */
            .navbar-nav {
                align-items: center;
                gap: 0.5rem;
            }

            .nav-link {
                position: relative;
                padding: 0.75rem 1.25rem !important;
                font-weight: 600;
                font-size: 0.95rem;
                color: var(--gray-700) !important;
                border-radius: 12px;
                transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin: 0 0.25rem;
                overflow: hidden;
            }

            .nav-link::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                opacity: 0;
                transition: all 0.3s ease;
                border-radius: 12px;
                z-index: -1;
            }

            .nav-link:hover::before,
            .nav-link.active::before {
                opacity: 1;
            }

            .nav-link:hover,
            .nav-link.active {
                color: white !important;
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
            }

            .nav-link i {
                font-size: 1rem;
                transition: all 0.3s ease;
            }

            .nav-link:hover i {
                transform: scale(1.2);
            }

            /* Dropdown menu premium */
            .dropdown-menu {
                border: none;
                border-radius: 20px;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(30px);
                box-shadow: 
                    0 20px 60px rgba(0, 0, 0, 0.15),
                    0 8px 32px rgba(102, 126, 234, 0.2),
                    inset 0 1px 0 rgba(255, 255, 255, 0.6);
                padding: 1.5rem 0;
                margin-top: 1rem;
                min-width: 280px;
                animation: dropdownSlideIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                border: 1px solid rgba(102, 126, 234, 0.1);
            }

            @keyframes dropdownSlideIn {
                from {
                    opacity: 0;
                    transform: translateY(-20px) scale(0.95);
                }
                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .dropdown-header {
                font-size: 0.8rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--gray-600) !important;
                padding: 0.5rem 1.5rem 0.75rem;
                margin-bottom: 0.5rem;
                position: relative;
            }

            .dropdown-header::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 1.5rem;
                right: 1.5rem;
                height: 2px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                border-radius: 1px;
            }

            .dropdown-item {
                padding: 0.8rem 1.5rem;
                font-weight: 500;
                font-size: 0.95rem;
                transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                position: relative;
                display: flex;
                align-items: center;
                border-radius: 12px;
                margin: 0 0.5rem;
                color: var(--gray-700);
                overflow: hidden;
            }

            .dropdown-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                transition: left 0.4s ease;
                z-index: -1;
            }

            .dropdown-item:hover::before {
                left: 0;
            }

            .dropdown-item:hover {
                color: white;
                transform: translateX(8px);
                background: transparent;
            }

            .dropdown-item i {
                width: 22px;
                margin-right: 12px;
                font-size: 1.1rem;
                transition: all 0.3s ease;
                text-align: center;
            }

            .dropdown-item:hover i {
                transform: scale(1.2) rotate(5deg);
            }

            .dropdown-item.text-danger:hover {
                color: white;
            }

            .dropdown-item.text-danger:hover::before {
                background: linear-gradient(135deg, var(--danger-color) 0%, #c0392b 100%);
            }

            .dropdown-divider {
                margin: 0.75rem 1rem;
                border-color: rgba(102, 126, 234, 0.1);
                opacity: 1;
            }

            /* Bouton connexion spectaculaire */
            .btn-outline-primary {
                border: 2px solid var(--primary-color);
                color: var(--primary-color);
                font-weight: 700;
                padding: 0.6rem 1.5rem;
                border-radius: 12px;
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                position: relative;
                overflow: hidden;
                background: transparent;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                margin-left: 1rem;
            }

            .btn-outline-primary::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
                transition: left 0.4s ease;
                z-index: -1;
            }

            .btn-outline-primary:hover::before {
                left: 0;
            }

            .btn-outline-primary:hover {
                color: white;
                border-color: var(--primary-color);
                transform: translateY(-3px);
                box-shadow: 0 12px 35px rgba(102, 126, 234, 0.4);
            }

            /* Particles flottantes */
            .navbar-particles {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                pointer-events: none;
                overflow: hidden;
            }

            .particle {
                position: absolute;
                width: 4px;
                height: 4px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
                border-radius: 50%;
                opacity: 0.6;
                animation: floatParticle 15s infinite linear;
            }

            .particle:nth-child(1) { left: 10%; animation-delay: 0s; }
            .particle:nth-child(2) { left: 30%; animation-delay: 3s; }
            .particle:nth-child(3) { left: 60%; animation-delay: 6s; }
            .particle:nth-child(4) { left: 85%; animation-delay: 9s; }

            @keyframes floatParticle {
                0% {
                    transform: translateY(100px) rotate(0deg);
                    opacity: 0;
                }
                10%, 90% {
                    opacity: 0.6;
                }
                100% {
                    transform: translateY(-20px) rotate(360deg);
                    opacity: 0;
                }
            }

            /* Navbar toggler moderne */
            .navbar-toggler {
                border: none;
                padding: 0.5rem;
                border-radius: 8px;
                transition: all 0.3s ease;
                background: rgba(102, 126, 234, 0.1);
            }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
            }

            .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28102, 126, 234, 1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='m4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            }

            /* Notifications Dropdown */
            .notification-dropdown {
                border-radius: 20px !important;
                background: rgba(255, 255, 255, 0.98) !important;
                backdrop-filter: blur(30px) !important;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15), 0 8px 32px rgba(102, 126, 234, 0.2) !important;
                border: 1px solid rgba(102, 126, 234, 0.1) !important;
                padding: 0 !important;
            }

            .notification-item {
                padding: 1rem;
                border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                transition: all 0.3s ease;
                cursor: pointer;
                position: relative;
                margin: 0;
            }

            .notification-item:hover {
                background: rgba(102, 126, 234, 0.05);
                transform: translateX(5px);
            }

            .notification-item.unread {
                background: rgba(102, 126, 234, 0.08);
                border-left: 4px solid var(--primary-color);
            }

            .notification-item.unread::before {
                content: '';
                position: absolute;
                top: 50%;
                right: 1rem;
                transform: translateY(-50%);
                width: 8px;
                height: 8px;
                background: var(--primary-color);
                border-radius: 50%;
                animation: pulse-notification 2s infinite;
            }

            @keyframes pulse-notification {
                0%, 100% { opacity: 1; transform: translateY(-50%) scale(1); }
                50% { opacity: 0.5; transform: translateY(-50%) scale(1.2); }
            }

            .notification-title {
                font-weight: 700;
                font-size: 0.9rem;
                color: var(--text-color);
                margin-bottom: 0.25rem;
                line-height: 1.2;
            }

            .notification-message {
                font-size: 0.8rem;
                color: var(--gray-600);
                line-height: 1.3;
                margin-bottom: 0.5rem;
            }

            .notification-time {
                font-size: 0.75rem;
                color: var(--gray-500);
                display: flex;
                align-items: center;
                gap: 0.25rem;
            }

            .notification-badge {
                animation: bounce-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%) !important;
                border: 2px solid white;
                box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
            }

            @keyframes bounce-in {
                0% { transform: translateX(-50%) translateY(-50%) scale(0); }
                50% { transform: translateX(-50%) translateY(-50%) scale(1.2); }
                100% { transform: translateX(-50%) translateY(-50%) scale(1); }
            }

            .notification-empty {
                padding: 2rem;
                text-align: center;
                color: var(--gray-500);
            }

            .notification-empty i {
                font-size: 2rem;
                margin-bottom: 1rem;
                opacity: 0.5;
            }

            #notification-badge {
                font-size: 0.7rem;
                padding: 0.2rem 0.4rem;
                min-width: 18px;
                height: 18px;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Toast Notifications améliorées */
            .toast-container {
                z-index: 1050;
            }

            .toast {
                border-radius: 15px;
                border: none;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(20px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
                animation: toastSlideIn 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                overflow: hidden;
            }

            @keyframes toastSlideIn {
                from {
                    transform: translateX(100%) scale(0.8);
                    opacity: 0;
                }
                to {
                    transform: translateX(0) scale(1);
                    opacity: 1;
                }
            }

            .toast-body {
                padding: 1.25rem;
                font-weight: 600;
                color: var(--gray-700);
            }

            /* Main Content avec animation */
            main {
                min-height: calc(100vh - 90px);
                padding: 2rem 0;
                animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            }

            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Responsive amélioré */
            @media (max-width: 991.98px) {
                body {
                    padding-top: 80px;
                }

                .navbar-brand {
                    font-size: 1.5rem;
                }

                .brand-icon {
                    width: 40px;
                    height: 40px;
                    font-size: 1.1rem;
                }

                .dropdown-menu {
                    border-radius: 15px;
                    margin-top: 0.5rem;
                    min-width: 250px;
                }

                .nav-link {
                    margin: 0.25rem 0;
                    border-radius: 8px;
                }

                .btn-outline-primary {
                    margin-left: 0;
                    margin-top: 0.5rem;
                    width: 100%;
                    justify-content: center;
                }
            }

            @media (max-width: 576px) {
                body {
                    padding-top: 70px;
                }

                .navbar {
                    padding: 0.75rem 0;
                }

                .navbar-brand {
                    font-size: 1.25rem;
                }

                .brand-icon {
                    width: 35px;
                    height: 35px;
                    font-size: 1rem;
                }
            }

            /* Animation de chargement de page */
            .page-loader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 50%, var(--primary-light) 100%);
                z-index: 9999;
                animation: pageLoad 2s ease-out forwards;
                }

            @keyframes pageLoad {
                0% { width: 0%; }
                50% { width: 80%; }
                100% { width: 100%; opacity: 0; }
            }

            /* Style spécial pour le menu Événements Annulés */
            .cancelled-menu-item {
                position: relative;
            }

            .cancelled-menu-item::after {
                content: '';
                position: absolute;
                right: 1.5rem;
                top: 50%;
                transform: translateY(-50%);
                width: 8px;
                height: 8px;
                background: var(--danger-color);
                border-radius: 50%;
                animation: pulse-danger 2s infinite;
            }

            .cancelled-menu-item:hover::after {
                animation: none;
                background: white;
            }

            .cancelled-menu-item .badge {
                animation: bounce-badge 1.5s infinite;
            }

            @keyframes pulse-danger {
                0%, 100% {
                    opacity: 1;
                    transform: translateY(-50%) scale(1);
                }
                50% {
                    opacity: 0.5;
                    transform: translateY(-50%) scale(1.2);
                }
            }

            @keyframes bounce-badge {
                0%, 20%, 50%, 80%, 100% {
                    transform: translateY(0);
                }
                40% {
                    transform: translateY(-3px);
                }
                60% {
                    transform: translateY(-1px);
                }
            }
        </style>
    {% endblock %}
</head>
