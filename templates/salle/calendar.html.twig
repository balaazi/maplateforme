{% extends 'base.html.twig' %}

{% block title %}Calendrier des réservations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
    <style>
        .calendar-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 15px 50px rgba(102, 126, 234, 0.3);
        }

        .calendar-container {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .fc {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .fc-event {
            border-radius: 8px;
            border: none !important;
            padding: 2px 6px;
            font-weight: 500;
            font-size: 0.85rem;
        }

        .fc-event-title {
            font-weight: 600;
        }

        /* Couleurs par type de réservation */
        .fc-event.event-reunion {
            background: linear-gradient(135deg, #4299e1, #3182ce);
            color: white;
        }

        .fc-event.event-formation {
            background: linear-gradient(135deg, #48bb78, #38a169);
            color: white;
        }

        .fc-event.event-conference {
            background: linear-gradient(135deg, #ed8936, #dd6b20);
            color: white;
        }

        .fc-event.event-workshop {
            background: linear-gradient(135deg, #9f7aea, #805ad5);
            color: white;
        }

        .fc-event.event-default {
            background: linear-gradient(135deg, #718096, #4a5568);
            color: white;
        }

        .fc-toolbar {
            margin-bottom: 25px !important;
        }

        .fc-button {
            background: linear-gradient(135deg, #667eea, #764ba2) !important;
            border: none !important;
            border-radius: 10px !important;
            font-weight: 600 !important;
            padding: 8px 16px !important;
            transition: all 0.3s ease !important;
        }

        .fc-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        }

        .fc-button:disabled {
            opacity: 0.6;
            transform: none !important;
        }

        .fc-today-button {
            background: linear-gradient(135deg, #48bb78, #38a169) !important;
        }

        .fc-daygrid-day.fc-day-today {
            background: rgba(102, 126, 234, 0.1) !important;
        }

        .fc-col-header-cell {
            background: #f8fafc;
            font-weight: 700;
            color: #2d3748;
            padding: 15px 0;
        }

        .filters-container {
            background: #f8fafc;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid #e2e8f0;
        }

        .filter-checkbox {
            margin-right: 20px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .filter-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            border-radius: 4px;
        }

        .stats-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #718096;
            font-size: 0.9rem;
        }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
            padding: 15px;
            background: #f8fafc;
            border-radius: 10px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }

        @media (max-width: 768px) {
            .calendar-container {
                padding: 15px;
            }
            
            .stats-cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="calendar-hero">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-2">Calendrier des Réservations</h1>
                <p class="lead mb-0">Vue d'ensemble de toutes les réservations de salles</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_salle_index') }}" class="btn btn-light btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>
                    Retour aux salles
                </a>
            </div>
        </div>
    </div>

    <!-- Statistiques rapides -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-number text-primary">{{ totalReservations ?? 0 }}</div>
            <div class="stat-label">Réservations ce mois</div>
        </div>
        <div class="stat-card">
            <div class="stat-number text-success">{{ sallesActives ?? 0 }}</div>
            <div class="stat-label">Salles actives</div>
        </div>
        <div class="stat-card">
            <div class="stat-number text-warning">{{ reservationsAujourdhui ?? 0 }}</div>
            <div class="stat-label">Réservations aujourd'hui</div>
        </div>
        <div class="stat-card">
            <div class="stat-number text-info">{{ tauxOccupation ?? 0 }}%</div>
            <div class="stat-label">Taux d'occupation</div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="filters-container">
        <h6 class="mb-3"><i class="fas fa-filter me-2"></i>Filtres d'affichage</h6>
        <div class="d-flex flex-wrap">
            <label class="filter-checkbox">
                <input type="checkbox" id="filter-reunion" checked>
                <span>Réunions</span>
            </label>
            <label class="filter-checkbox">
                <input type="checkbox" id="filter-formation" checked>
                <span>Formations</span>
            </label>

        </div>
    </div>

    <!-- Légende -->
    <div class="legend">
        <div class="legend-item">
            <div class="legend-color" style="background: linear-gradient(135deg, #4299e1, #3182ce);"></div>
            <span>Réunions</span>
        </div>
        <div class="legend-item">
            <div class="legend-color" style="background: linear-gradient(135deg, #48bb78, #38a169);"></div>
            <span>Formations</span>
        </div>

    </div>

    <!-- Calendrier -->
    <div class="calendar-container">
        <div id="calendar"></div>
    </div>
</div>

<!-- Modal pour les détails d'un événement -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventModalLabel">
                    <i class="fas fa-calendar-alt me-2"></i>
                    Détails de la réservation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="eventModalBody">
                <!-- Contenu dynamique -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Fermer
                </button>
                <button type="button" class="btn btn-primary" id="btnVoirSalle">
                    <i class="fas fa-door-open me-1"></i>Voir la salle
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');
        
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            buttonText: {
                today: 'Aujourd\'hui',
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour'
            },
            events: '/api/calendar/events', // À implémenter
            eventClick: function(info) {
                showEventModal(info.event);
            },
            eventDidMount: function(info) {
                // Ajouter des classes CSS selon le type
                var motif = info.event.extendedProps.motif || '';
                var className = 'event-default';
                
                if (motif.toLowerCase().includes('réunion') || motif.toLowerCase().includes('reunion')) {
                    className = 'event-reunion';
                } else if (motif.toLowerCase().includes('formation')) {
                    className = 'event-formation';

                }
                
                info.el.classList.add(className);
            }
        });

        calendar.render();

        // Gestion des filtres
        document.querySelectorAll('[id^="filter-"]').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                updateEventVisibility();
            });
        });

        function updateEventVisibility() {
            var events = calendar.getEvents();
            events.forEach(function(event) {
                var motif = event.extendedProps.motif || '';
                var show = false;

                if (document.getElementById('filter-reunion').checked && 
                    (motif.toLowerCase().includes('réunion') || motif.toLowerCase().includes('reunion'))) {
                    show = true;
                }
                if (document.getElementById('filter-formation').checked && 
                    motif.toLowerCase().includes('formation')) {
                    show = true;
                }


                event.setProp('display', show ? 'auto' : 'none');
            });
        }

        function showEventModal(event) {
            var modalBody = document.getElementById('eventModalBody');
            var btnVoirSalle = document.getElementById('btnVoirSalle');
            
            modalBody.innerHTML = `
                <div class="row">
                    <div class="col-md-6">
                        <h6><i class="fas fa-bookmark text-primary me-2"></i>Motif</h6>
                        <p class="mb-3">${event.title}</p>
                        
                        <h6><i class="fas fa-user text-info me-2"></i>Réservé par</h6>
                        <p class="mb-3">${event.extendedProps.reservePar || 'Non spécifié'}</p>
                        
                        <h6><i class="fas fa-door-open text-success me-2"></i>Salle</h6>
                        <p class="mb-3">${event.extendedProps.salle || 'Non spécifiée'}</p>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="fas fa-clock text-warning me-2"></i>Horaires</h6>
                        <p class="mb-3">
                            <strong>Début :</strong> ${event.start.toLocaleString('fr-FR')}<br>
                            <strong>Fin :</strong> ${event.end.toLocaleString('fr-FR')}
                        </p>
                        
                        <h6><i class="fas fa-info-circle text-muted me-2"></i>Statut</h6>
                        <p class="mb-3">
                            <span class="badge bg-success">${event.extendedProps.statut || 'Confirmée'}</span>
                        </p>
                    </div>
                </div>
            `;
            
            btnVoirSalle.onclick = function() {
                if (event.extendedProps.salleId) {
                    window.location.href = `/gestion-salles/disponibilite/${event.extendedProps.salleId}`;
                }
            };
            
            new bootstrap.Modal(document.getElementById('eventModal')).show();
        }
    });
    </script>
{% endblock %} 