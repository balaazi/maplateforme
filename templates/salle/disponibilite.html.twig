{% extends 'base.html.twig' %}

{% block title %}Planning de {{ salle.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .planning-hero {
            background: linear-gradient(135deg, #4299e1 0%, #667eea 50%, #764ba2 100%);
            color: white;
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 50px rgba(66, 153, 225, 0.3);
        }

        .planning-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23dots)"/></svg>');
            opacity: 0.3;
        }

        .planning-content {
            position: relative;
            z-index: 2;
        }

        .room-status {
            display: inline-flex;
            align-items: center;
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
        }

        .status-libre {
            background: rgba(72, 187, 120, 0.9);
            color: white;
            box-shadow: 0 4px 15px rgba(72, 187, 120, 0.3);
        }

        .status-occupee {
            background: rgba(245, 101, 101, 0.9);
            color: white;
            box-shadow: 0 4px 15px rgba(245, 101, 101, 0.3);
        }

        .status-libre_temporaire {
            background: rgba(237, 137, 54, 0.9);
            color: white;
            box-shadow: 0 4px 15px rgba(237, 137, 54, 0.3);
        }

        .status-desactivee {
            background: rgba(160, 174, 192, 0.9);
            color: white;
            box-shadow: 0 4px 15px rgba(160, 174, 192, 0.3);
        }

        .modern-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: all 0.3s ease;
            margin-bottom: 25px;
        }

        .modern-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
        }

        .card-header-modern {
            background: linear-gradient(135deg, #f8fafc, #e2e8f0);
            padding: 20px 25px;
            border-bottom: 1px solid #e2e8f0;
            position: relative;
        }

        .card-header-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #4299e1, #667eea);
        }

        .card-header-modern h5 {
            margin: 0;
            color: #2d3748;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body-modern {
            padding: 25px;
        }

        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 12px;
            border-left: 4px solid #e2e8f0;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-item.capacity {
            border-left-color: #4299e1;
        }

        .info-item.status {
            border-left-color: #48bb78;
        }

        .current-reservation {
            background: linear-gradient(135deg, #fef5f5, #fed7d7);
            border: 1px solid #fc8181;
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            position: relative;
        }

        .current-reservation::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #f56565, #e53e3e);
            border-radius: 15px 15px 0 0;
        }

        .next-reservation {
            background: linear-gradient(135deg, #fffaf0, #feebc8);
            border: 1px solid #f6ad55;
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            position: relative;
        }

        .next-reservation::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #ed8936, #dd6b20);
            border-radius: 15px 15px 0 0;
        }

        .reservation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }

        .reservation-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .reservation-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #48bb78, #38a169);
        }

        .reservation-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .time-slot {
            background: linear-gradient(135deg, #f0fff4, #c6f6d5);
            border: 1px solid #68d391;
            border-radius: 12px;
            padding: 15px;
            margin: 10px 0;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
        }

        .time-slot:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 20px rgba(72, 187, 120, 0.2);
        }

        .reservation-form {
            background: linear-gradient(135deg, #f8fafc, #edf2f7);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid #e2e8f0;
        }

        .form-group-modern {
            margin-bottom: 25px;
        }

        .form-label-modern {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-control-modern {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: white;
        }

        .form-control-modern:focus {
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
            outline: none;
        }

        .btn-reserve {
            background: linear-gradient(135deg, #4299e1, #667eea);
            border: none;
            color: white;
            padding: 15px 30px;
            border-radius: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(66, 153, 225, 0.3);
            width: 100%;
            justify-content: center;
        }

        .btn-reserve:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(66, 153, 225, 0.4);
            background: linear-gradient(135deg, #3182ce, #5a67d8);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #718096, #4a5568);
            border: none;
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(113, 128, 150, 0.3);
            color: white;
            text-decoration: none;
        }

        .empty-day {
            text-align: center;
            padding: 40px;
            background: linear-gradient(135deg, #e6fffa, #b2f5ea);
            border-radius: 15px;
            color: #2d3748;
        }

        .empty-icon {
            width: 80px;
            height: 80px;
            background: rgba(56, 178, 172, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 2rem;
            color: #38b2ac;
        }

        @media (max-width: 768px) {
            .planning-hero {
                padding: 20px;
                text-align: center;
            }
            
            .reservation-grid {
                grid-template-columns: 1fr;
            }
            
            .card-body-modern {
                padding: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    {# Messages Flash #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                {% if type == 'success' %}
                    <i class="fas fa-check-circle me-2"></i>
                {% elseif type == 'error' %}
                    <i class="fas fa-exclamation-triangle me-2"></i>
                {% endif %}
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Hero Section Planning #}
    <div class="planning-hero">
        <div class="planning-content">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-2">Planning de {{ salle.nom }}</h1>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-users me-2"></i>
                            <span>{{ salle.capacite }} personnes</span>
                        </div>
                        <div>
                            <span class="room-status status-{{ statutActuel.statut }}">
                                <i class="fas fa-circle me-2"></i>
                                {{ statutActuel.libelle }}
                            </span>
                        </div>
                    </div>
                </div>
                <div>
                    <a href="{{ path('app_salle_index') }}" class="btn-back">
                        <i class="fas fa-arrow-left"></i>
                        <span>Retour aux salles</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="modern-card">
                <div class="card-header-modern">
                    <h5>
                        <i class="fas fa-info-circle"></i>
                        Informations de la salle
                    </h5>
                </div>
                <div class="card-body-modern">
                    <div class="info-item">
                        <i class="fas fa-door-open text-primary me-3"></i>
                        <div>
                            <strong>{{ salle.nom }}</strong>
                        </div>
                    </div>
                    
                    <div class="info-item capacity">
                        <i class="fas fa-users text-info me-3"></i>
                        <div>
                            <strong>{{ salle.capacite }}</strong> personnes
                        </div>
                    </div>
                    
                    {% if reservationActuelle %}
                        <div class="current-reservation">
                            <h6 class="fw-bold mb-3">
                                <i class="fas fa-play-circle text-danger me-2"></i>
                                Réservation en cours
                            </h6>
                            <div class="mb-2">
                                <i class="fas fa-bookmark text-danger me-2"></i>
                                <strong>{{ reservationActuelle.motif }}</strong>
                            </div>
                            <div class="mb-2">
                                <i class="fas fa-user text-danger me-2"></i>
                                {{ reservationActuelle.reservePar }}
                            </div>
                            <div>
                                <i class="fas fa-clock text-danger me-2"></i>
                                Fin : {{ reservationActuelle.dateFin|date('H:i') }}
                            </div>
                        </div>
                    {% endif %}

                    {% if prochaineReservation %}
                        <div class="next-reservation">
                            <h6 class="fw-bold mb-3">
                                <i class="fas fa-clock text-warning me-2"></i>
                                Prochaine réservation
                            </h6>
                            <div class="mb-2">
                                <i class="fas fa-bookmark text-warning me-2"></i>
                                <strong>{{ prochaineReservation.motif }}</strong>
                            </div>
                            <div class="mb-2">
                                <i class="fas fa-user text-warning me-2"></i>
                                {{ prochaineReservation.reservePar }}
                            </div>
                            <div class="mb-1">
                                <i class="fas fa-play text-warning me-2"></i>
                                Début : {{ prochaineReservation.dateDebut|date('H:i') }}
                            </div>
                            <div>
                                <i class="fas fa-stop text-warning me-2"></i>
                                Fin : {{ prochaineReservation.dateFin|date('H:i') }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="modern-card">
                <div class="card-header-modern">
                    <h5>
                        <i class="fas fa-calendar-alt"></i>
                        Planning du {{ 'now'|date('d/m/Y') }}
                    </h5>
                </div>
                <div class="card-body-modern">
                    {% if reservationsJour is not empty %}
                        <h6 class="mb-3 fw-bold">
                            <i class="fas fa-list me-2"></i>
                            Réservations du jour
                        </h6>
                        <div class="reservation-grid">
                            {% for reservation in reservationsJour %}
                                <div class="reservation-card">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="fw-bold text-primary">
                                            {{ reservation.dateDebut|date('H:i') }} - {{ reservation.dateFin|date('H:i') }}
                                        </div>
                                        <div>
                                            {% if reservation.statut == 'confirmee' %}
                                                <span class="badge bg-success">Confirmée</span>
                                            {% elseif reservation.statut == 'en_attente' %}
                                                <span class="badge bg-warning">En attente</span>
                                            {% else %}
                                                <span class="badge bg-danger">Annulée</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <i class="fas fa-bookmark text-muted me-2"></i>
                                        <strong>{{ reservation.motif }}</strong>
                                    </div>
                                    <div>
                                        <i class="fas fa-user text-muted me-2"></i>
                                        {{ reservation.reservePar }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-day">
                            <div class="empty-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <h5 class="mb-2">Journée libre !</h5>
                            <p class="mb-0">Aucune réservation prévue aujourd'hui</p>
                        </div>
                    {% endif %}

                    {% if creneauxLibres is not empty %}
                        <h6 class="mt-4 mb-3 fw-bold">
                            <i class="fas fa-clock-o me-2"></i>
                            Créneaux libres aujourd'hui
                        </h6>
                        {% for creneau in creneauxLibres %}
                            <div class="time-slot">
                                <i class="fas fa-clock text-success"></i>
                                <div class="flex-grow-1">
                                    <strong>{{ creneau.debut|date('H:i') }} - {{ creneau.fin|date('H:i') }}</strong>
                                </div>
                                <div class="text-muted">
                                    {{ ((creneau.fin.timestamp - creneau.debut.timestamp) / 3600)|round(1) }}h
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="mt-4 p-3 bg-warning bg-opacity-10 border border-warning rounded-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                <span class="text-warning fw-bold">Aucun créneau libre aujourd'hui</span>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="modern-card">
                <div class="card-header-modern">
                    <h5>
                        <i class="fas fa-plus-circle"></i>
                        Nouvelle réservation
                    </h5>
                </div>
                <div class="card-body-modern">
                    <div class="reservation-form">
                        <form method="post" action="{{ path('salle_reserver', {id: salle.id}) }}">
                            <div class="row">
                                <div class="col-md-6 form-group-modern">
                                    <label for="dateDebut" class="form-label-modern">
                                        <i class="fas fa-play text-success"></i>
                                        Date et heure de début
                                    </label>
                                    <input type="datetime-local" class="form-control-modern" id="dateDebut" name="dateDebut" 
                                           value="{{ 'tomorrow'|date('Y-m-d') }}T{{ salle.debutReservation|date('H:i') }}" required>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-clock me-1"></i>
                                        Salle ouverte de {{ salle.debutReservation|date('H:i') }} à {{ salle.finReservation|date('H:i') }}
                                    </small>
                                </div>
                                <div class="col-md-6 form-group-modern">
                                    <label for="dateFin" class="form-label-modern">
                                        <i class="fas fa-stop text-danger"></i>
                                        Date et heure de fin
                                    </label>
                                    <input type="datetime-local" class="form-control-modern" id="dateFin" name="dateFin" 
                                           value="{{ 'tomorrow'|date('Y-m-d') }}T{{ salle.debutReservation|date_modify('+2 hours')|date('H:i') }}" required>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Maximum {{ salle.finReservation|date('H:i') }}
                                    </small>
                                </div>
                            </div>
                            <div class="form-group-modern">
                                <label for="motif" class="form-label-modern">
                                    <i class="fas fa-bookmark text-primary"></i>
                                    Motif de la réservation
                                </label>
                                <input type="text" class="form-control-modern" id="motif" name="motif" 
                                       placeholder="Ex: Réunion équipe, Formation, Conférence..." required>
                                <small class="form-text text-muted mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Décrivez brièvement l'objet de la réservation
                                </small>
                            </div>
                            <div class="form-group-modern">
                                <label for="reservePar" class="form-label-modern">
                                    <i class="fas fa-user text-info"></i>
                                    Réservé par
                                </label>
                                <input type="text" class="form-control-modern" id="reservePar" name="reservePar" 
                                       value="{{ app.user ? (app.user.nom ~ ' ' ~ app.user.prenom) : '' }}" 
                                       placeholder="Nom de la personne qui réserve" required>
                                <small class="form-text text-muted mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Indiquez le nom de la personne responsable de la réservation
                                </small>
                            </div>
                            <button type="submit" class="btn-reserve">
                                <i class="fas fa-calendar-plus"></i>
                                <span>Créer la réservation</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Validation des dates
    const dateDebut = document.getElementById('dateDebut');
    const dateFin = document.getElementById('dateFin');
    const motif = document.getElementById('motif');
    const reservePar = document.getElementById('reservePar');
    const form = document.querySelector('form[action*="reserver"]');
    
    // Validation en temps réel
    dateDebut.addEventListener('change', function() {
        const debutDate = new Date(this.value);
        const heureDebut = debutDate.getHours();
        const minute = debutDate.getMinutes();
        
        // Vérifier si l'heure est dans les heures d'ouverture (8h-18h)
        if (heureDebut < 8) {
            debutDate.setHours(8, 0);
            this.value = debutDate.toISOString().slice(0, 16);
        } else if (heureDebut >= 18) {
            debutDate.setHours(17, 0);
            this.value = debutDate.toISOString().slice(0, 16);
        }
        
        dateFin.min = this.value;
        if (dateFin.value < this.value) {
            const debut = new Date(this.value);
            debut.setHours(debut.getHours() + 1);
            // S'assurer que la fin ne dépasse pas 18h
            if (debut.getHours() > 18) {
                debut.setHours(18, 0);
            }
            dateFin.value = debut.toISOString().slice(0, 16);
        }
        validateForm();
    });
    
    dateFin.addEventListener('change', function() {
        const finDate = new Date(this.value);
        const heureFin = finDate.getHours();
        
        // Vérifier si l'heure est dans les heures d'ouverture (8h-18h)
        if (heureFin < 8) {
            finDate.setHours(8, 0);
            this.value = finDate.toISOString().slice(0, 16);
        } else if (heureFin > 18) {
            finDate.setHours(18, 0);
            this.value = finDate.toISOString().slice(0, 16);
        }
        
        if (this.value < dateDebut.value) {
            alert('La date de fin doit être postérieure à la date de début');
            this.value = '';
        }
        validateForm();
    });

    motif.addEventListener('input', validateForm);
    reservePar.addEventListener('input', validateForm);

    function validateForm() {
        const submitBtn = document.querySelector('.btn-reserve');
        const isValid = dateDebut.value && dateFin.value && motif.value.trim() && reservePar.value.trim();
        
        if (submitBtn) {
            submitBtn.disabled = !isValid;
            submitBtn.style.opacity = isValid ? '1' : '0.6';
        }
    }

    // Validation à la soumission
    if (form) {
        form.addEventListener('submit', function(e) {
            const motifValue = motif.value.trim();
            const reserveParValue = reservePar.value.trim();

            if (!motifValue || !reserveParValue) {
                e.preventDefault();
                alert('Veuillez remplir tous les champs obligatoires.');
                return false;
            }

            if (motifValue.length < 3) {
                e.preventDefault();
                alert('Le motif doit contenir au moins 3 caractères.');
                motif.focus();
                return false;
            }

            if (reserveParValue.length < 2) {
                e.preventDefault();
                alert('Le nom de la personne doit contenir au moins 2 caractères.');
                reservePar.focus();
                return false;
            }

            // Animation de soumission
            const submitBtn = document.querySelector('.btn-reserve');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Création en cours...</span>';
                submitBtn.disabled = true;
            }
        });
    }

    // Validation initiale
    validateForm();
});
</script>
{% endblock %} 