{% extends 'base.html.twig' %}

{% block title %}Créer un procès-verbal - {{ event.title }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .pv-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .pv-header {
        border-bottom: 2px solid #f3f4f6;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .pv-title {
        font-size: 2rem;
        color: #1a202c;
        margin-bottom: 0.5rem;
    }

    .event-info {
        background: #f8fafc;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #4f46e5;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        font-size: 1rem;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .actions-collection {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1rem;
    }

    .action-item {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        margin: 0.25rem;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
        border: none;
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
        border: none;
    }

    .btn-success {
        background: #10b981;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #ef4444;
        color: white;
        border: none;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion de la collection d'actions
    const actionsContainer = document.querySelector('.actions-collection');
    if (actionsContainer) {
        const addButton = document.createElement('button');
        addButton.type = 'button';
        addButton.className = 'btn btn-success btn-sm';
        addButton.innerHTML = '<i class="fas fa-plus"></i> Ajouter une action';
        addButton.onclick = addAction;
        
        actionsContainer.appendChild(addButton);
    }
    
    function addAction() {
        const container = document.querySelector('[data-prototype]');
        if (!container) return;
        
        const prototype = container.dataset.prototype;
        const index = document.querySelectorAll('.action-item').length;
        const newForm = prototype.replace(/__name__/g, index);
        
        const div = document.createElement('div');
        div.className = 'action-item';
        div.innerHTML = newForm + '<button type="button" class="btn btn-danger btn-sm" onclick="removeAction(this)"><i class="fas fa-trash"></i></button>';
        
        container.appendChild(div);
    }
    
    window.removeAction = function(button) {
        button.closest('.action-item').remove();
    };
});
</script>
{% endblock %}

{% block body %}
<div class="pv-container">
    <div class="pv-header">
        <h1 class="pv-title">
            <i class="fas fa-file-alt text-primary"></i>
            Créer un procès-verbal
        </h1>
        <p class="text-muted">Rédigez le procès-verbal pour la réunion ci-dessous</p>
    </div>

    <div class="event-info">
        <h3><i class="fas fa-calendar-alt"></i> {{ event.title }}</h3>
        <p><strong>Date :</strong> {{ event.dateHeure|date('d/m/Y à H:i') }}</p>
        <p><strong>Durée :</strong> {{ event.duree }} minutes</p>
        {% if event.salle %}
            <p><strong>Salle :</strong> {{ event.salle.nom }}</p>
        {% endif %}
        <p><strong>Organisateur :</strong> {{ event.organizer.prenom }} {{ event.organizer.nom }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'pv-form'}}) }}
    
    <div class="form-group">
        {{ form_label(form.dateHeure) }}
        {{ form_widget(form.dateHeure) }}
        {{ form_help(form.dateHeure) }}
        {{ form_errors(form.dateHeure) }}
    </div>

    <div class="form-group">
        {{ form_label(form.participants) }}
        {{ form_widget(form.participants) }}
        {{ form_help(form.participants) }}
        {{ form_errors(form.participants) }}
    </div>

    <div class="form-group">
        {{ form_label(form.pointsAbordes) }}
        {{ form_widget(form.pointsAbordes) }}
        {{ form_help(form.pointsAbordes) }}
        {{ form_errors(form.pointsAbordes) }}
    </div>

    <div class="form-group">
        {{ form_label(form.decisionsPrises) }}
        {{ form_widget(form.decisionsPrises) }}
        {{ form_help(form.decisionsPrises) }}
        {{ form_errors(form.decisionsPrises) }}
    </div>

    <div class="form-group">
        {{ form_label(form.actions) }}
        <div class="actions-collection" data-prototype="{{ form_widget(form.actions.vars.prototype)|e('html_attr') }}">
            {% for action in form.actions %}
                <div class="action-item">
                    {{ form_widget(action) }}
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeAction(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            {% endfor %}
        </div>
        {{ form_help(form.actions) }}
        {{ form_errors(form.actions) }}
    </div>

    <div class="form-group">
        <div class="form-check">
            {{ form_widget(form.finalise) }}
            {{ form_label(form.finalise) }}
        </div>
        {{ form_help(form.finalise) }}
        {{ form_errors(form.finalise) }}
    </div>

    <div class="form-actions">
        {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
        <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-secondary btn-lg">
            <i class="fas fa-arrow-left"></i> Retour à l'événement
        </a>
    </div>

    {{ form_row(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
</div>
{% endblock %}