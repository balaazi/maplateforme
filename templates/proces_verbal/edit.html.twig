{% extends 'base.html.twig' %}

{% block title %}Modifier le procès-verbal - {{ event.title }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .pv-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .pv-header {
        border-bottom: 2px solid #f3f4f6;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .pv-title {
        font-size: 2rem;
        color: #1a202c;
        margin-bottom: 0.5rem;
    }

    .event-info {
        background: #f8fafc;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #4f46e5;
        margin-bottom: 2rem;
    }

    .warning-box {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 2rem;
        color: #92400e;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.75rem;
        font-size: 1rem;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }


    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        margin: 0.25rem;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
        border: none;
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
        border: none;
    }

    /* Styles pour la liste des participants */
    .participants-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 0.5rem;
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        background: #f9fafb;
    }

    .participants-list .form-check {
        margin-bottom: 0.5rem;
        padding: 0.5rem;
        background: white;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
    }

    .participants-list .form-check:hover {
        background: #f0f9ff;
        border-color: #3b82f6;
    }

    .participant-info {
        display: flex;
        flex-direction: column;
        margin-left: 1.5rem;
    }

    .participant-name {
        font-weight: 500;
        color: #374151;
    }

    .participant-email {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .btn-success {
        background: #10b981;
        color: white;
        border: none;
    }

    .btn-danger {
        background: #ef4444;
        color: white;
        border: none;
    }


    /* Bouton Tout sélectionner */
    .select-all-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        margin-bottom: 1rem;
        transition: background-color 0.2s;
    }

    .select-all-btn:hover {
        background: #2563eb;
    }

    /* Compteur de participants */
    .participants-count {
        background: #f0f9ff;
        border: 1px solid #bbdefb;
        border-radius: 6px;
        padding: 0.5rem 1rem;
        margin-bottom: 1rem;
        color: #0d47a1;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .participants-count span {
        font-weight: 600;
        color: #1976d2;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {

    // Gestion du bouton "Tout sélectionner" pour les participants
    const selectAllBtn = document.getElementById('select-all-btn');
    if (selectAllBtn) {
        selectAllBtn.addEventListener('click', function() {
            const checkboxes = document.querySelectorAll('.participants-list input[type="checkbox"]');
            const allChecked = Array.from(checkboxes).every(cb => cb.checked);
            
            checkboxes.forEach(cb => {
                cb.checked = !allChecked;
            });
            
            updateSelectAllButton();
        });
    }

    function updateSelectAllButton() {
        const checkboxes = document.querySelectorAll('.participants-list input[type="checkbox"]');
        const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        const totalCount = checkboxes.length;
        
        // Mettre à jour le bouton
        if (checkedCount === 0) {
            selectAllBtn.textContent = 'Tout sélectionner';
        } else if (checkedCount === totalCount) {
            selectAllBtn.textContent = 'Tout désélectionner';
        } else {
            selectAllBtn.textContent = `Sélectionné: ${checkedCount}/${totalCount}`;
        }
        
        // Mettre à jour le compteur
        const countElement = document.getElementById('participants-count');
        if (countElement) {
            countElement.textContent = checkedCount;
        }
    }

    // Mettre à jour le bouton au chargement
    updateSelectAllButton();
    
    // Ajouter des écouteurs d'événements pour les cases à cocher
    const participantCheckboxes = document.querySelectorAll('.participants-list input[type="checkbox"]');
    participantCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateSelectAllButton);
    });
});
</script>
{% endblock %}

{% block body %}
<div class="pv-container">
    <div class="pv-header">
        <h1 class="pv-title">
            <i class="fas fa-edit text-primary"></i>
            Modifier le procès-verbal
        </h1>
        <p class="text-muted">Modifiez le procès-verbal pour la réunion ci-dessous</p>
    </div>

    {% if procesVerbal.finalise %}
        <div class="warning-box">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Attention :</strong> Ce procès-verbal est finalisé et ne peut normalement plus être modifié. 
            Si vous le décochez et l'enregistrez, il redeviendra modifiable.
        </div>
    {% endif %}

    <div class="event-info">
        <h3><i class="fas fa-calendar-alt"></i> {{ event.title }}</h3>
        <p><strong>Date :</strong> {{ event.dateHeure|date('d/m/Y à H:i') }}</p>
        <p><strong>Durée :</strong> {{ event.duree }} minutes</p>
        {% if event.salle %}
            <p><strong>Salle :</strong> {{ event.salle.nom }}</p>
        {% endif %}
        <p><strong>Organisateur :</strong> {{ event.organizer.prenom }} {{ event.organizer.nom }}</p>
        <p><strong>Rédacteur :</strong> {{ procesVerbal.redacteur.prenom }} {{ procesVerbal.redacteur.nom }}</p>
        <p><strong>Créé le :</strong> {{ procesVerbal.dateCreation|date('d/m/Y à H:i') }}</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'pv-form'}}) }}
    
    <div class="form-group">
        {{ form_label(form.dateHeure) }}
        {{ form_widget(form.dateHeure) }}
        {{ form_help(form.dateHeure) }}
        {{ form_errors(form.dateHeure) }}
    </div>

    <div class="form-group">
        {{ form_label(form.participants) }}
        <button type="button" id="select-all-btn" class="select-all-btn">Tout sélectionner</button>
        <div class="participants-count">
            <span id="participants-count">0</span> utilisateur(s) sélectionné(s) sur {{ form.participants|length }} disponible(s)
        </div>
        <div class="participants-list">
            {% for choice in form.participants %}
                <div class="form-check">
                    {{ form_widget(choice) }}
                    <div class="participant-info">
                        <span class="participant-name">{{ choice.vars.label|split(' (')[0] }}</span>
                        <span class="participant-email">{{ choice.vars.label|split(' (')[1]|trim(')') }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
        {{ form_help(form.participants) }}
        {{ form_errors(form.participants) }}
    </div>

    <div class="form-group">
        {{ form_label(form.pointsAbordes) }}
        {{ form_widget(form.pointsAbordes) }}
        {{ form_help(form.pointsAbordes) }}
        {{ form_errors(form.pointsAbordes) }}
    </div>

    <div class="form-group">

        {{ form_label(form.decisionsPrises) }}
        {{ form_widget(form.decisionsPrises) }}
        {{ form_help(form.decisionsPrises) }}
        {{ form_errors(form.decisionsPrises) }}
    </div>


    <div class="form-group">
        <div class="form-check">
            {{ form_widget(form.finalise) }}
            {{ form_label(form.finalise) }}
        </div>
        {{ form_help(form.finalise) }}
        {{ form_errors(form.finalise) }}
    </div>

    <div class="form-actions">
        {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
        <a href="{{ path('proces_verbal_show', {'id': procesVerbal.id}) }}" class="btn btn-secondary btn-lg">
            <i class="fas fa-arrow-left"></i> Annuler
        </a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}