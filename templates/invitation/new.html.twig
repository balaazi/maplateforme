{% extends 'base.html.twig' %}

{% block title %}Envoyer une invitation - EventHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .invitation-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }
        
        .invitation-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 4rem 2rem;
            border-radius: 30px;
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(102,126,234,0.2);
        }
        
        .invitation-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 2px,
                rgba(255,255,255,0.03) 2px,
                rgba(255,255,255,0.03) 4px
            );
            animation: movePattern 20s linear infinite;
        }
        
        .invitation-header::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.1) 0%, transparent 50%),
                         radial-gradient(circle at 80% 20%, rgba(255,255,255,0.1) 0%, transparent 50%);
        }
        
        @keyframes movePattern {
            0% { transform: translateX(-100px) translateY(-100px); }
            100% { transform: translateX(100px) translateY(100px); }
        }
        
        .header-content {
            position: relative;
            z-index: 2;
            text-align: center;
        }
        
        .invitation-icon {
            background: rgba(255,255,255,0.25);
            width: 100px;
            height: 100px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            backdrop-filter: blur(15px);
            border: 3px solid rgba(255,255,255,0.4);
            font-size: 2.5rem;
            animation: float 3s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }
        
        .invitation-header h1 {
            font-size: 3rem;
            font-weight: 800;
            margin: 0 0 1rem 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        
        .event-title {
            background: rgba(255,255,255,0.2);
            padding: 1rem 2rem;
            border-radius: 15px;
            margin-top: 1.5rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            font-size: 1.3rem;
            font-weight: 600;
        }
        
        .form-container {
            max-width: 600px;
            margin: 0 auto;
        }
        
        .form-card {
            background: white;
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
        }
        
        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #667eea, #764ba2);
        }
        
        .form-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(102,126,234,0.05) 0%, transparent 70%);
            transform: scale(0);
            transition: transform 0.6s ease;
        }
        
        .form-card:hover::after {
            transform: scale(1);
        }
        
        .form-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
        }
        
        .form-title-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            box-shadow: 0 8px 25px rgba(102,126,234,0.3);
        }
        
        .form-field {
            position: relative;
            margin-bottom: 2rem;
        }
        
        .form-control {
            width: 100%;
            padding: 1.25rem 1.5rem;
            border: 2px solid #e9ecef;
            border-radius: 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            background: #fff;
            font-family: inherit;
            position: relative;
            z-index: 1000 !important;
            pointer-events: auto !important;
            opacity: 1 !important;
            user-select: text !important;
            cursor: text !important;
        }
        
        /* Sécurité supplémentaire pour l'interaction */
        .form-control:disabled,
        .form-control[readonly] {
            pointer-events: auto !important;
            opacity: 1 !important;
            cursor: text !important;
        }
        
        .form-field * {
            pointer-events: auto !important;
        }
        
        /* Force l'affichage immédiat des champs de formulaire */
        .form-field,
        .form-actions {
            opacity: 1 !important;
            transform: translateY(0) !important;
            visibility: visible !important;
            display: block !important;
        }
        
        .form-control:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.1);
            transform: translateY(-2px);
        }
        
        .form-control:hover {
            border-color: #667eea;
            transform: translateY(-1px);
        }
        
        .form-label {
            position: absolute;
            top: 1.25rem;
            left: 1.5rem;
            color: #7f8c8d;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            pointer-events: none;
            background: white;
            padding: 0 0.5rem;
            z-index: 3;
        }
        
        .form-control:focus + .form-label,
        .form-control:not(:placeholder-shown) + .form-label,
        .has-value + .form-label {
            top: -0.5rem;
            left: 1rem;
            font-size: 0.9rem;
            color: #667eea;
            font-weight: 700;
        }
        
        .form-field::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(118,75,162,0.1));
            border-radius: 15px;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 1;
        }
        
        .form-field:hover::before {
            opacity: 1;
        }
        
        .form-errors {
            color: #dc3545;
            font-size: 0.9rem;
            margin-top: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
        }
        
        .form-errors::before {
            content: '⚠️';
            font-size: 1rem;
        }
        
        .btn {
            padding: 1.25rem 2.5rem;
            border-radius: 15px;
            font-weight: 700;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 1rem;
            min-width: 200px;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(40,167,69,0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(40,167,69,0.4);
            color: white;
            text-decoration: none;
        }
        
        .btn-secondary {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(108,117,125,0.3);
        }
        
        .btn-secondary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(108,117,125,0.4);
            color: white;
            text-decoration: none;
        }
        
        .form-actions {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            margin-top: 3rem;
            flex-wrap: wrap;
        }
        
        .back-button-container {
            display: flex;
            justify-content: center;
            margin-top: 2rem;
        }
        
        @media (max-width: 768px) {
            .invitation-container {
                padding: 1rem;
            }
            
            .invitation-header {
                padding: 2.5rem 1.5rem;
                border-radius: 20px;
            }
            
            .invitation-header h1 {
                font-size: 2rem;
            }
            
            .form-card {
                padding: 2rem;
                border-radius: 20px;
            }
            
            .form-title {
                font-size: 1.5rem;
                flex-direction: column;
                gap: 1rem;
            }
            
            .form-title-icon {
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
            }
            
            .form-control {
                padding: 1rem 1.25rem;
                font-size: 1rem;
            }
            
            .form-label {
                font-size: 1rem;
                top: 1rem;
                left: 1.25rem;
            }
            
            .form-control:focus + .form-label,
            .form-control:not(:placeholder-shown) + .form-label,
            .has-value + .form-label {
                font-size: 0.85rem;
            }
            
            .btn {
                min-width: auto;
                width: 100%;
                margin-bottom: 1rem;
            }
            
            .form-actions {
                flex-direction: column;
            }
        }
        
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeIn 0.8s ease-out forwards;
        }
        
        @keyframes fadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .loading {
            position: relative;
        }
        
        .loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            margin: -10px 0 0 -10px;
            border: 2px solid transparent;
            border-top: 2px solid #fff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .success-animation {
            animation: successPulse 0.6s ease-out;
        }
        
        @keyframes successPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="invitation-container">
        <div class="container-fluid">
            <!-- En-tête d'invitation -->
            <div class="invitation-header fade-in">
                <div class="header-content">
                    <div class="invitation-icon">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <h1>Envoyer une invitation</h1>
                    <div class="event-title">
                        <i class="fas fa-calendar-alt"></i> {{ event.title }}
                    </div>
                </div>
            </div>

            <!-- Formulaire d'invitation -->
            <div class="form-container">
                <div class="form-card fade-in" style="animation-delay: 0.1s;">
                    <div class="form-title">
                        <div class="form-title-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        Détails de l'invitation
                    </div>
                    
                    {{ form_start(form, {'attr': {'class': 'invitation-form', 'novalidate': true}}) }}
                    
                        <div class="form-field" style="opacity: 1; transform: translateY(0); margin-bottom: 1.5rem;">
                            {{ form_label(form.name, null, {'attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.name) }}
                                    {{ form_errors(form.name) }}
                        </div>
                        
                        <div class="form-field" style="opacity: 1; transform: translateY(0); margin-bottom: 1.5rem;">
                            {{ form_label(form.email, null, {'attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.email) }}
                                    {{ form_errors(form.email) }}
                        </div>
                        
                        <div class="form-actions" style="opacity: 1; transform: translateY(0);">
                            <button type="submit" class="btn btn-primary" id="submit-btn">
                                <i class="fas fa-paper-plane"></i>
                                Envoyer l'invitation
                            </button>
                        </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Bouton retour -->
            <div class="back-button-container fade-in" style="animation-delay: 0.5s;">
                <a href="{{ path('invitation_index', {'eventId': event.id}) }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Retour à la liste des invitations
                </a>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Page chargée - Initialisation des champs');
            
            // SIMPLIFICATION TOTALE - Supprimer tous les événements problématiques
            const allInputs = document.querySelectorAll('input, textarea, select, button');
            allInputs.forEach(input => {
                // Nettoyer tous les attributs bloquants
                input.removeAttribute('disabled');
                input.removeAttribute('readonly');
                input.style.pointerEvents = 'auto';
                input.style.opacity = '1';
                input.style.zIndex = '1000';
                input.tabIndex = 0;
                
                console.log('Champ activé:', input.type || input.tagName);
            });
            
            // Test simple pour vérifier que la saisie fonctionne
            const nameInput = document.querySelector('input[name*="name"]');
            const emailInput = document.querySelector('input[name*="email"]');
            
            if (nameInput) {
                nameInput.addEventListener('input', function() {
                    console.log('Saisie dans le champ nom:', this.value);
                });
                nameInput.focus();
                console.log('Focus placé sur le champ nom');
            }
            
            if (emailInput) {
                emailInput.addEventListener('input', function() {
                    console.log('Saisie dans le champ email:', this.value);
                });
            }
            
            // Gestion simple du formulaire
            const form = document.querySelector('.invitation-form');
            const submitBtn = document.getElementById('submit-btn');
            
            if (submitBtn) {
                submitBtn.addEventListener('click', function(e) {
                    console.log('Bouton cliqué');
                    if (nameInput && !nameInput.value.trim()) {
                        e.preventDefault();
                        alert('Veuillez entrer un nom');
                        nameInput.focus();
                        return;
                    }
                    if (emailInput && !emailInput.value.trim()) {
                    e.preventDefault();
                        alert('Veuillez entrer un email');
                        emailInput.focus();
                        return;
                    }
                    console.log('Envoi du formulaire...');
                });
            }
            
            // Test de focus immédiat
            setTimeout(() => {
                if (nameInput) {
                    nameInput.focus();
                    nameInput.click();
                    console.log('Focus forcé sur le champ nom après 500ms');
                }
            }, 500);
        });
    </script>
{% endblock %}
