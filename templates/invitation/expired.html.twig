{% extends 'base.html.twig' %}

{% block title %}Invitation Expirée - EventHub{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white text-center">
                    <i class="fas fa-clock fa-3x mb-3"></i>
                    <h2>Invitation Expirée</h2>
                </div>
                <div class="card-body text-center">
                    <div class="alert alert-warning">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle"></i>
                            Cette invitation a expiré
                        </h4>
                        <p class="mb-0">
                            {% if event_passed is defined and event_passed %}
                                La date de l'événement est dépassée, cette invitation n'est plus valide.
                            {% else %}
                                Le délai de réponse à cette invitation a dépassé.
                                Elle ne peut plus être traitée.
                            {% endif %}
                        </p>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <h5>Détails de l'invitation</h5>
                            <ul class="list-unstyled">
                                <li><strong>Nom :</strong> {{ invitation.name }}</li>
                                <li><strong>Email :</strong> {{ invitation.email }}</li>
                                <li><strong>Événement :</strong> {{ invitation.event.title }}</li>
                                <li><strong>Date de création :</strong> {{ invitation.createdAt|date('d/m/Y H:i') }}</li>
                                <li><strong>Statut :</strong> 
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-clock"></i> EXPIRÉE
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>Détails de l'événement</h5>
                            <ul class="list-unstyled">
                                <li><strong>Titre :</strong> {{ invitation.event.title }}</li>
                                <li><strong>Date :</strong> {{ invitation.event.dateHeure|date('d/m/Y H:i') }}</li>
                                <li><strong>Lieu :</strong> {{ invitation.event.lieu ?? 'Non spécifié' }}</li>
                                <li><strong>Description :</strong> {{ invitation.event.description|slice(0, 100) }}{% if invitation.event.description|length > 100 %}...{% endif %}</li>
                            </ul>
                        </div>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted">
                            <i class="fas fa-info-circle"></i>
                            Si vous souhaitez participer à cet événement, veuillez contacter l'organisateur 
                            ou demander une nouvelle invitation.
                        </p>
                    </div>

                    <div class="mt-4">
                        <a href="{{ path('app_home') }}" class="btn btn-primary">
                            <i class="fas fa-home"></i> Retour à l'accueil
                        </a>
                        <a href="{{ path('event_show', {'id': invitation.event.id}) }}" class="btn btn-outline-secondary">
                            <i class="fas fa-calendar"></i> Voir l'événement
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


