{% extends 'base.html.twig' %}

{% block title %}Liste de présence - {{ event.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .attendance-container {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }
        
        .attendance-header {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            padding: 3rem 2rem;
            border-radius: 25px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(40,167,69,0.2);
        }
        
        .attendance-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 2px,
                rgba(255,255,255,0.03) 2px,
                rgba(255,255,255,0.03) 4px
            );
            animation: movePattern 20s linear infinite;
        }
        
        @keyframes movePattern {
            0% { transform: translateX(-100px) translateY(-100px); }
            100% { transform: translateX(100px) translateY(100px); }
        }
        
        .header-content {
            position: relative;
            z-index: 2;
            text-align: center;
        }
        
        .attendance-icon {
            background: rgba(255,255,255,0.25);
            width: 100px;
            height: 100px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            backdrop-filter: blur(15px);
            border: 3px solid rgba(255,255,255,0.4);
            font-size: 2.5rem;
        }
        
        .attendance-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0 0 1rem 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }
        
        .event-title {
            background: rgba(255,255,255,0.2);
            padding: 1rem 2rem;
            border-radius: 15px;
            margin-top: 1rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            font-size: 1.3rem;
            font-weight: 600;
        }
        
        .attendance-card {
            background: white;
            border-radius: 25px;
            padding: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
        }
        
        .attendance-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #28a745, #20c997);
        }
        
        .attendance-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .attendance-icon-small {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        
        .attendance-list {
            border-collapse: separate;
            border-spacing: 0 0.5rem;
            width: 100%;
        }
        
        .attendance-list thead th {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.85rem;
            padding: 1.5rem 1rem;
            border: none;
            position: relative;
        }
        
        .attendance-list thead th:first-child {
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
        }
        
        .attendance-list thead th:last-child {
            border-top-right-radius: 15px;
            border-bottom-right-radius: 15px;
        }
        
        .attendance-list tbody tr {
            background: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            border-radius: 15px;
        }
        
        .attendance-list tbody tr:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }
        
        .attendance-list tbody td {
            padding: 1.5rem 1rem;
            border: none;
            vertical-align: middle;
        }
        
        .attendance-list tbody td:first-child {
            border-top-left-radius: 15px;
            border-bottom-left-radius: 15px;
        }
        
        .attendance-list tbody td:last-child {
            border-top-right-radius: 15px;
            border-bottom-right-radius: 15px;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
            margin-right: 1rem;
        }
        
        .user-info {
            display: flex;
            align-items: center;
        }
        
        .user-name {
            font-weight: 600;
            color: #2c3e50;
        }
        
        .user-email {
            font-size: 0.85rem;
            color: #6c757d;
        }
        
        .attendance-toggle {
            position: relative;
            width: 60px;
            height: 30px;
        }
        
        .attendance-toggle input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .attendance-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 30px;
        }
        
        .attendance-slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        
        input:checked + .attendance-slider {
            background-color: #28a745;
        }
        
        input:focus + .attendance-slider {
            box-shadow: 0 0 1px #28a745;
        }
        
        input:checked + .attendance-slider:before {
            transform: translateX(30px);
        }
        
        .attendance-status {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            min-width: 100px;
            text-align: center;
        }
        
        .status-present {
            background-color: rgba(40,167,69,0.1);
            color: #28a745;
            border: 1px solid rgba(40,167,69,0.2);
        }
        
        .status-absent {
            background-color: rgba(220,53,69,0.1);
            color: #dc3545;
            border: 1px solid rgba(220,53,69,0.2);
        }
        
        .attendance-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }
        
        .btn-attendance {
            padding: 1rem 2rem;
            border-radius: 15px;
            font-weight: 700;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.9rem;
        }
        
        .btn-all-present {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(40,167,69,0.3);
        }
        
        .btn-all-present:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(40,167,69,0.4);
            color: white;
        }
        
        .btn-all-absent {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(220,53,69,0.3);
        }
        
        .btn-all-absent:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(220,53,69,0.4);
            color: white;
        }
        
        .btn-print {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(23,162,184,0.3);
        }
        
        .btn-print:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(23,162,184,0.4);
            color: white;
        }
        
        .btn-back {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(108,117,125,0.3);
        }
        
        .btn-back:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(108,117,125,0.4);
            color: white;
        }
        
        .notification {
            position: fixed;
            top: 2rem;
            right: 2rem;
            padding: 1rem 2rem;
            border-radius: 15px;
            color: white;
            font-weight: 600;
            transform: translateX(400px);
            transition: all 0.5s ease;
            z-index: 1000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        
        .notification.show {
            transform: translateX(0);
        }
        
        .notification.success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        }
        
        .notification.error {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        }
        
        .participant-count {
            background: rgba(255,255,255,0.2);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 1rem;
            font-weight: 600;
            margin-top: 1rem;
            display: inline-block;
        }
        
        @media print {
            .no-print {
                display: none !important;
            }
            
            body {
                background: white !important;
            }
            
            .attendance-container {
                background: white !important;
                padding: 0 !important;
            }
            
            .attendance-header {
                background: white !important;
                color: black !important;
                box-shadow: none !important;
                padding: 1rem !important;
                margin-bottom: 1rem !important;
            }
            
            .attendance-header::before,
            .attendance-header::after {
                display: none !important;
            }
            
            .attendance-icon {
                display: none !important;
            }
            
            .attendance-header h1 {
                color: black !important;
                text-shadow: none !important;
                font-size: 1.8rem !important;
            }
            
            .event-title {
                background: none !important;
                border: none !important;
                color: black !important;
                padding: 0 !important;
            }
            
            .attendance-card {
                box-shadow: none !important;
                padding: 0 !important;
                border-radius: 0 !important;
            }
            
            .attendance-card::before {
                display: none !important;
            }
            
            .attendance-list thead th {
                background: white !important;
                color: black !important;
                border-bottom: 2px solid #dee2e6 !important;
            }
            
            .attendance-list tbody tr {
                box-shadow: none !important;
                border-bottom: 1px solid #dee2e6 !important;
            }
            
            .attendance-toggle {
                display: none !important;
            }
            
            .attendance-status {
                border: none !important;
                background: none !important;
                padding: 0 !important;
            }
            
            .status-present {
                color: black !important;
            }
            
            .status-absent {
                color: black !important;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="attendance-container">
        <div class="container">
            <!-- En-tête -->
            <div class="attendance-header no-print">
                <div class="header-content">
                    <div class="attendance-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h1>Liste de présence - Formation</h1>
                    <div class="event-title">
                        <i class="fas fa-calendar-alt"></i> {{ event.title }}
                    </div>
                    <div class="participant-count">
                        <i class="fas fa-users"></i> {{ participations|length }} participant(s) inscrit(s)
                    </div>
                </div>
            </div>

            <!-- Version imprimable -->
            <div class="d-none d-print-block">
                <h1 class="text-center mb-4">Liste de présence - {{ event.title }}</h1>
                <div class="row mb-4">
                    <div class="col-6">
                        <p><strong>Date :</strong> {{ event.dateHeure|date('d/m/Y') }}</p>
                        <p><strong>Heure :</strong> {{ event.dateHeure|date('H:i') }}</p>
                    </div>
                    <div class="col-6">
                        <p><strong>Durée :</strong> {{ event.duree }} minutes</p>
                        <p><strong>Lieu :</strong> {% if event.salle %}{{ event.salle.nom }}{% else %}Non défini{% endif %}</p>
                    </div>
            </div>
            </div>

            <!-- Liste des participants -->
            <div class="attendance-card">
                <div class="attendance-title no-print">
                    <div class="attendance-icon-small">
                        <i class="fas fa-users"></i>
                    </div>
                    Participants inscrits
                </div>

                {% if participations|length > 0 %}
                    <div class="attendance-buttons no-print">
                
                        <button type="button" class="btn-attendance btn-print" onclick="window.print()">
                            <i class="fas fa-print"></i> Imprimer
                        </button>
                    </div>

                    <div class="table-responsive mt-4">
                        <table class="attendance-list">
                            <thead>
                                <tr>
                                    <th>Participant</th>
                                    <th>Email</th>
                                    <th class="text-center">Présence</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                        {% for participation in participations %}
                                    <tr>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                        {{ participation.user.prenom|first|upper }}{{ participation.user.nom|first|upper }}
                                    </div>
                                                <div>
                                                    <div class="user-name">{{ participation.user.prenom }} {{ participation.user.nom }}</div>
                                    </div>
                                </div>
                                        </td>
                                        <td>
                                            <div class="user-email">{{ participation.user.email }}</div>
                                        </td>
                                        <td class="text-center">
                                            <div class="attendance-status {% if participation.isPresent %}status-present{% else %}status-absent{% endif %}" id="status-{{ participation.id }}">
                                        {% if participation.isPresent %}
                                                    <i class="fas fa-check-circle"></i> Présent
                                        {% else %}
                                                    <i class="fas fa-times-circle"></i> Absent
                                        {% endif %}
                                    </div>
                                        </td>
                                       
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="d-print-block d-none mt-5">
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-5">Signature du formateur :</p>
                                </div>
                            <div class="col-6 text-end">
                                <p class="mb-5">Date : {{ "now"|date('d/m/Y') }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Aucun participant inscrit pour cette formation.
                    </div>
                {% endif %}
            </div>

            <!-- Boutons de navigation -->
            <div class="text-center mt-4 no-print">
                <a href="{{ path('event_show', {'id': event.id}) }}" class="btn-attendance btn-back">
                    <i class="fas fa-arrow-left"></i> Retour à l'événement
                </a>
            </div>
        </div>
    </div>
    
    <!-- Notification -->
    <div id="notification" class="notification"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function showNotification(message, type) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type} show`;
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }
        
        function updateAttendance(participationId, isPresent) {
            fetch('{{ path('event_update_training_attendance', {'id': event.id}) }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `participation_id=${participationId}&is_present=${isPresent ? 'true' : 'false'}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Mettre à jour l'interface
                    const statusElement = document.getElementById(`status-${participationId}`);
                    if (statusElement) {
                        if (isPresent) {
                            statusElement.innerHTML = '<i class="fas fa-check-circle"></i> Présent';
                            statusElement.className = 'attendance-status status-present';
                        } else {
                            statusElement.innerHTML = '<i class="fas fa-times-circle"></i> Absent';
                            statusElement.className = 'attendance-status status-absent';
                        }
                    }
                    
                    showNotification(data.message, 'success');
                } else {
                    showNotification(data.message || 'Erreur lors de la mise à jour', 'error');
                    // Réinitialiser le switch si erreur
                    const checkbox = document.querySelector(`input[data-participation-id="${participationId}"]`);
                    if (checkbox) {
                        checkbox.checked = !isPresent;
                    }
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                showNotification('Erreur de connexion', 'error');
                // Réinitialiser le switch si erreur
                const checkbox = document.querySelector(`input[data-participation-id="${participationId}"]`);
                if (checkbox) {
                    checkbox.checked = !isPresent;
                }
            });
        }
        
        function markAllPresent() {
            const checkboxes = document.querySelectorAll('.attendance-toggle input[type="checkbox"]');
            checkboxes.forEach(checkbox => {
                if (!checkbox.checked) {
                    checkbox.checked = true;
                    updateAttendance(checkbox.dataset.participationId, true);
                }
            });
        }
        
        function markAllAbsent() {
            const checkboxes = document.querySelectorAll('.attendance-toggle input[type="checkbox"]');
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    checkbox.checked = false;
                    updateAttendance(checkbox.dataset.participationId, false);
                }
            });
        }
    </script>
{% endblock %}