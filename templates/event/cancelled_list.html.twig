{% extends 'base.html.twig' %}

{% block title %}Événements annulés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .cancelled-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(231, 76, 60, 0.3);
        }

        .cancelled-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border-left: 5px solid #e74c3c;
            opacity: 0.7;
            transition: all 0.3s ease;
        }

        .cancelled-card:hover {
            opacity: 1;
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12);
        }

        .event-title {
            color: #2c3e50;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .event-info {
            color: #7f8c8d;
            margin-bottom: 15px;
        }

        .cancelled-badge {
            background: #e74c3c;
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.85em;
            font-weight: 600;
            margin-bottom: 15px;
            display: inline-block;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .btn-delete {
            background: #dc3545;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9em;
            transition: background-color 0.3s;
        }

        .btn-delete:hover {
            background: #c82333;
            color: white;
        }

        .btn-back {
            background: #6c757d;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9em;
            transition: background-color 0.3s;
        }

        .btn-back:hover {
            background: #5a6268;
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

        .empty-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            color: #e74c3c;
        }

        .info-box {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }

        .info-box h6 {
            color: #856404;
            margin-bottom: 10px;
        }

        .info-box p {
            color: #856404;
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    {# Messages Flash #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                {% if type == 'success' %}
                    <i class="fas fa-check-circle me-2"></i>
                {% elseif type == 'error' %}
                    <i class="fas fa-exclamation-triangle me-2"></i>
                {% endif %}
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="cancelled-header">
        <div>
            <h1 class="display-5 fw-bold mb-2">
                <i class="fas fa-ban me-3"></i>
                Événements annulés
            </h1>
            <p class="mb-0">Gérez vos événements annulés - Supprimez-les définitivement si nécessaire</p>
        </div>
    </div>

    <div class="info-box">
        <h6><i class="fas fa-info-circle me-2"></i>Information</h6>
        <p>
            Les événements annulés ne s'affichent plus dans la liste principale des événements. 
            Vous pouvez les supprimer définitivement ici si vous le souhaitez. 
            <strong>Attention :</strong> Cette action est irréversible.
        </p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-list me-2"></i>Liste des événements annulés ({{ events|length }})</h3>
        <a href="{{ path('event_list') }}" class="btn-back">
            <i class="fas fa-arrow-left me-2"></i>Retour aux événements
        </a>
    </div>

    {% if events|length > 0 %}
        {% for event in events %}
            <div class="cancelled-card">
                <div class="cancelled-badge">
                    <i class="fas fa-times me-1"></i>Annulé
                </div>
                
                <h4 class="event-title">{{ event.title }}</h4>
                
                <div class="event-info">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="fas fa-calendar me-2"></i>
                                <strong>Date :</strong> {{ event.dateHeure|date('d/m/Y à H:i') }}
                            </p>
                            <p class="mb-2">
                                <i class="fas fa-clock me-2"></i>
                                <strong>Durée :</strong> {{ event.duree }} minutes
                            </p>
                        </div>
                        <div class="col-md-6">
                            {% if event.salle %}
                                <p class="mb-2">
                                    <i class="fas fa-door-open me-2"></i>
                                    <strong>Salle :</strong> {{ event.salle.nom }}
                                </p>
                            {% endif %}
                            <p class="mb-2">
                                <i class="fas fa-user me-2"></i>
                                <strong>Organisateur :</strong> {{ event.organizer.prenom }} {{ event.organizer.nom }}
                            </p>
                        </div>
                    </div>
                </div>

                {% if event.description %}
                    <div class="event-info">
                        <p><strong>Description :</strong></p>
                        <p>{{ event.description|length > 200 ? event.description|slice(0, 200) ~ '...' : event.description }}</p>
                    </div>
                {% endif %}

                <div class="action-buttons">
                    <a href="{{ path('event_delete', {'id': event.id}) }}" 
                       class="btn-delete"
                       onclick="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cet événement ? Cette action est irréversible.')">
                        <i class="fas fa-trash me-2"></i>Supprimer définitivement
                    </a>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-smile"></i>
            </div>
            <h3>Aucun événement annulé</h3>
            <p class="text-muted">
                Vous n'avez aucun événement annulé pour le moment.<br>
                C'est une bonne chose !
            </p>
            <a href="{{ path('event_list') }}" class="btn-back mt-3">
                <i class="fas fa-arrow-left me-2"></i>Retour aux événements
            </a>
        </div>
    {% endif %}
</div>
{% endblock %} 