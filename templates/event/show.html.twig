{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} - Détails de l'événement{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .event-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .event-header {
        border-bottom: 2px solid #f3f4f6;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .event-title {
        font-size: 2rem;
        color: #1a202c;
        margin-bottom: 0.5rem;
    }

    .event-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .meta-item {
        background: #f8fafc;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #4f46e5;
    }

    .meta-label {
        font-size: 0.875rem;
        color: #64748b;
        margin-bottom: 0.25rem;
    }

    .meta-value {
        font-size: 1rem;
        color: #1e293b;
        font-weight: 500;
    }

    .event-description {
        background: #f8fafc;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        white-space: pre-line;
    }

    .tools-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .tool-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .tool-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .tool-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        color: #4f46e5;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
    }

    .btn-edit {
        background: #4f46e5;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s;
    }

    .btn-edit:hover {
        background: #4338ca;
    }

    .participant-info {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .alert {
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid transparent;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .btn-primary, .btn-secondary {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        margin: 0.5rem 0.5rem 0.5rem 0;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #218838 0%, #1ba085 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
    }

    .btn-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
    }

    .btn-secondary:hover {
        background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
    }

    .btn-cancel {
        background: #ef4444;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s;
    }

    .btn-cancel:hover {
        background: #dc2626;
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background-color 0.3s;
        margin-left: 0.5rem;
    }

    .btn-secondary:hover {
        background: #4b5563;
        color: white;
        text-decoration: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="event-container">
    <div class="event-header">
        <h1 class="event-title">{{ event.title }}</h1>
        {% if event.status %}
            <span class="badge {% if event.status == 'annulé' %}bg-danger{% else %}bg-success{% endif %}">
                {{ event.status|capitalize }}
            </span>
        {% endif %}
    </div>

    <div class="event-meta">
        <div class="meta-item">
            <div class="meta-label">Date et heure</div>
            <div class="meta-value">{{ event.dateHeure|date('d/m/Y H:i') }}</div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Durée</div>
            <div class="meta-value">{{ event.duree }} minutes</div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Lieu</div>
            <div class="meta-value">
                {% if event.salle %}
                    <i class="fas fa-door-open me-2"></i>{{ event.salle.nom }}
                    {% if event.salle.localisation %}
                        <br><small class="text-muted">{{ event.salle.localisation }}</small>
                    {% endif %}
                {% else %}
                    <i class="fas fa-question-circle me-2"></i>Non défini

                {% endif %}
            </div>
        </div>
        <div class="meta-item">
            <div class="meta-label">Catégorie</div>
            <div class="meta-value">{{ event.category }}</div>
        </div>
    </div>

    {% if event.description %}
    <div class="event-description">
        <h3>Description</h3>
        {{ event.description|nl2br }}
    </div>
    {% endif %}

    {% if documents|length > 0 %}
    <div class="event-description">
        <h3>Documents</h3>
        <div class="documents-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
            {% for document in documents %}
                <div class="document-card" style="background: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <div class="document-header" style="display: flex; align-items: center; margin-bottom: 0.5rem;">
                        <div class="document-type-icon" style="font-size: 1.5rem; margin-right: 0.5rem;">
                            {% set fileExtension = document.fileName|split('.')|last|lower %}
                            {% if fileExtension in ['pdf'] %}
                                <i class="fas fa-file-pdf" style="color: #e53e3e;"></i>
                            {% elseif fileExtension in ['doc', 'docx'] %}
                                <i class="fas fa-file-word" style="color: #2b6cb0;"></i>
                            {% elseif fileExtension in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}
                                <i class="fas fa-file-image" style="color: #38a169;"></i>
                            {% else %}
                                <i class="fas fa-file" style="color: #718096;"></i>
                            {% endif %}
                        </div>
                        <div>
                            <h4 style="margin: 0; font-size: 1rem;">{{ document.fileName|split('.')|first|title }}</h4>
                        </div>
                    </div>
                    <div class="document-actions" style="margin-top: 0.5rem;">
                        <a href="{{ path('document_download', {'id': document.id}) }}" class="btn btn-sm btn-primary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                            <i class="fas fa-download"></i> Télécharger
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <div class="tools-section">
        {% if event.googleDriveUrl %}
        <a href="{{ event.googleDriveUrl }}" target="_blank" class="tool-card">
            <div class="tool-icon">📁</div>
            <h4>Google Drive</h4>
            <p>Accéder aux documents partagés</p>
        </a>
        {% endif %}

        {% if event.category|lower not in ['réunion', 'reunion'] %}
            <a href="{{ path('app_collaborative_notes_list', {'id': event.id}) }}" class="tool-card">
                <div class="tool-icon">📋</div>
                <h4>Notes Collaboratives</h4>
                <p>Gérer les notes de l'événement</p>
            </a>
        {% endif %}

        {% if event.etherpadUrl %}
        <a href="{{ event.etherpadUrl }}" target="_blank" class="tool-card">
            <div class="tool-icon">📝</div>
            <h4>Etherpad</h4>
            <p>Notes collaboratives</p>
        </a>
        {% endif %}

        <a href="{{ path('event_attendance', {'id': event.id}) }}" class="tool-card">
            <div class="tool-icon">👥</div>
            <h4>Participants</h4>
            <p>Voir les présences</p>
        </a>

        {% if event.category|lower == 'réunion' or event.category|lower == 'reunion' %}
            {% if procesVerbal %}
                <a href="{{ path('proces_verbal_show', {'id': procesVerbal.id}) }}" class="tool-card" style="border: 2px solid #8b5cf6;">
                    <div class="tool-icon" style="color: #8b5cf6;">📝</div>
                    <h4 style="color: #8b5cf6;">Procès-verbal</h4>
                    <p>
                        {% if procesVerbal.finalise %}
                            <span style="color: #059669;">✓ Finalisé</span>
                        {% else %}
                            <span style="color: #d97706;">📝 Brouillon</span>
                        {% endif %}
                    </p>
                </a>
            {% else %}
                <a href="{{ path('proces_verbal_create', {'eventId': event.id}) }}" class="tool-card" style="border: 2px solid #e74c3c; background: linear-gradient(135deg, #fff5f5 0%, #feebc8 100%);">
                    <div class="tool-icon" style="color: #e74c3c; font-size: 2.5rem;">📄</div>
                    <h4 style="color: #e74c3c; font-weight: 700;">PV Reunion</h4>
                    <p style="color: #e74c3c;">Créer le procès-verbal</p>
                </a>
            {% endif %}
        {% endif %}

        {% if event.category|lower == 'formation' and (isCreator or hasAdminAccess) %}
        <a href="{{ path('event_training_attendance', {'id': event.id}) }}" class="tool-card" style="border: 2px solid #28a745;">
            <div class="tool-icon" style="color: #28a745;">📋</div>
            <h4 style="color: #28a745;">Liste de présence</h4>
            <p>Cocher présents/absents</p>
        </a>
        {% endif %}
    </div>

    {% if isCreator %}
    <div class="action-buttons">
        <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn-edit">
            <i class="fas fa-edit"></i> Modifier
        </a>
        {% if event.status != 'annulé' %}
            <a href="{{ path('event_cancel', {'id': event.id}) }}" class="btn-cancel" 
               onclick="return confirm('Êtes-vous sûr de vouloir annuler cet événement ?')">
                <i class="fas fa-times"></i> Annuler
            </a>
        {% endif %}

        <a href="{{ path('event_list') }}" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>
    {% elseif hasAcceptedInvitation %}
    <div class="participant-info">
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            <strong>Événement accepté</strong> - Vous participez à cet événement
        </div>
        <div class="action-buttons">
            <a href="{{ path('participant_events') }}" class="btn-primary">
                <i class="fas fa-arrow-left"></i> Retour à mes événements
            </a>
        </div>
    </div>
    {% else %}
    <div class="action-buttons">
        <a href="{{ path('event_list') }}" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste des événements
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
