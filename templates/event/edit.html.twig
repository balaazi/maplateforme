{% extends 'base.html.twig' %}

{% block title %}Modifier l'Événement - {{ event.title }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3><i class="fas fa-edit"></i> Modifier l'Événement</h3>
                    </div>
                    <div class="card-body">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle"></i> {{ message }}
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-circle"></i> {{ message }}
                            </div>
                        {% endfor %}
                        
                        {{ form_start(form) }}
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.title, 'Titre de l\'événement') }}
                                    {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.title) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.category, 'Catégorie') }}
                                    {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.category) }}
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                            {{ form_errors(form.description) }}
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.dateHeure, 'Date et heure') }}
                                    {{ form_widget(form.dateHeure, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.dateHeure) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.duree, 'Durée (minutes)') }}
                                    {{ form_widget(form.duree, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.duree) }}
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            {{ form_label(form.salle, 'Salle') }}
                            {{ form_widget(form.salle, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.salle) }}
                        </div>
                        

                        
                        <div class="form-group">
                            {{ form_label(form.imageFile, 'Ajouter des documents') }}
                            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.imageFile) }}
                        </div>
                        
                        <div class="form-actions mt-4">
                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-eye"></i> Voir l'événement
                            </a>
                            <a href="{{ path('event_list') }}" class="btn btn-secondary">
                                <i class="fas fa-list"></i> Liste des événements
                            </a>
                            <button type="submit" class="btn btn-primary float-right">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
