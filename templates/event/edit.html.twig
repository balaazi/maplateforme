{% extends 'base.html.twig' %}

{% block title %}Modifier l'Événement - {{ event.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Styles spécifiques pour la page d'édition d'événement */
        .event-edit-container {
            background: #f8fafc;
            min-height: 100vh;
            padding: 2rem 0;
            position: relative;
        }

        .event-edit-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border: 1px solid #e5e7eb;
            position: relative;
            overflow: hidden;
            animation: slideInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .event-edit-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, #667eea, #764ba2, #f093fb, #667eea);
            background-size: 200% 100%;
            animation: gradientShift 3s ease-in-out infinite;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .event-edit-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .event-edit-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .event-edit-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0;
            position: relative;
            z-index: 1;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .event-edit-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-top: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .event-edit-body {
            padding: 3rem;
        }

        .form-section {
            margin-bottom: 2.5rem;
            padding: 2rem;
            background: rgba(248, 250, 252, 0.5);
            border-radius: 16px;
            border: 1px solid rgba(102, 126, 234, 0.1);
            transition: all 0.3s ease;
        }

        .form-section:hover {
            background: rgba(248, 250, 252, 0.8);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.1);
        }

        .form-section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .form-section-title i {
            color: #667eea;
            font-size: 1.5rem;
        }

        .form-group-enhanced {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-group-enhanced label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.75rem;
            display: block;
            font-size: 0.95rem;
            letter-spacing: 0.025em;
        }

        .form-control-enhanced {
            width: 100%;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 1rem;
            background: white;
            color: #1f2937;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            font-family: inherit;
            position: relative;
        }

        .form-control-enhanced:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            background: white;
            transform: translateY(-1px);
        }

        .form-control-enhanced::placeholder {
            color: #9ca3af;
            font-style: italic;
        }

        .form-textarea-enhanced {
            min-height: 120px;
            resize: vertical;
            line-height: 1.6;
        }

        .form-actions-enhanced {
            display: flex;
            gap: 1rem;
            margin-top: 3rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-enhanced {
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
            min-width: 160px;
            justify-content: center;
        }

        .btn-enhanced::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        .btn-enhanced:hover::before {
            left: 100%;
        }

        .btn-primary-enhanced {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 6px -1px rgba(102, 126, 234, 0.2);
        }

        .btn-primary-enhanced:hover {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
            color: white;
        }

        .btn-secondary-enhanced {
            background: #f8fafc;
            color: #374151;
            border: 2px solid #e5e7eb;
        }

        .btn-secondary-enhanced:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
            color: #374151;
        }

        .file-upload-area {
            border: 2px dashed #d1d5db;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            background: #f9fafb;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .file-upload-area:hover {
            border-color: #667eea;
            background: #f0f4ff;
        }

        .file-upload-area.dragover {
            border-color: #667eea;
            background: #f0f4ff;
            transform: scale(1.02);
        }

        .file-upload-icon {
            font-size: 3rem;
            color: #9ca3af;
            margin-bottom: 1rem;
        }

        .file-upload-text {
            color: #6b7280;
            font-weight: 500;
        }

        .alert-enhanced {
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            border-radius: 12px;
            border: none;
            position: relative;
            overflow: hidden;
            animation: slideInDown 0.5s ease-out;
        }

        .alert-enhanced::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: currentColor;
        }

        .alert-success-enhanced {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            color: #065f46;
            border-left: 4px solid #10b981;
        }

        .alert-danger-enhanced {
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }

        @keyframes slideInUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes slideInDown {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .event-edit-container {
                padding: 1rem 0;
            }

            .event-edit-body {
                padding: 2rem;
            }

            .form-section {
                padding: 1.5rem;
            }

            .event-edit-title {
                font-size: 2rem;
            }

            .form-actions-enhanced {
                flex-direction: column;
            }

            .btn-enhanced {
                width: 100%;
            }
        }

        @media (max-width: 576px) {
            .event-edit-body {
                padding: 1.5rem;
            }

            .form-section {
                padding: 1rem;
            }

            .event-edit-title {
                font-size: 1.75rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="event-edit-container">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-8">
                    <div class="event-edit-card">
                        <div class="event-edit-header">
                            <h1 class="event-edit-title">
                                <i class="fas fa-edit"></i>
                                Modifier l'Événement
                            </h1>
                            <p class="event-edit-subtitle">
                                Mettez à jour les informations de votre événement
                            </p>
                        </div>
                        
                        <div class="event-edit-body">
                            {% for message in app.flashes('success') %}
                                <div class="alert-enhanced alert-success-enhanced">
                                    <i class="fas fa-check-circle"></i> {{ message }}
                                </div>
                            {% endfor %}
                            
                            {% for message in app.flashes('error') %}
                                <div class="alert-enhanced alert-danger-enhanced">
                                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                                </div>
                            {% endfor %}
                            
                            {{ form_start(form, {'attr': {'class': 'event-edit-form'}}) }}
                            
                            <!-- Section Informations de base -->
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="fas fa-info-circle"></i>
                                    Informations de base
                                </h3>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group-enhanced">
                                            {{ form_label(form.title, 'Titre de l\'événement') }}
                                            {{ form_widget(form.title, {'attr': {'class': 'form-control-enhanced', 'placeholder': 'Entrez le titre de votre événement'}}) }}
                                            {{ form_errors(form.title) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group-enhanced">
                                            {{ form_label(form.category, 'Catégorie') }}
                                            {{ form_widget(form.category, {'attr': {'class': 'form-control-enhanced'}}) }}
                                            {{ form_errors(form.category) }}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group-enhanced">
                                    {{ form_label(form.description, 'Description') }}
                                    {{ form_widget(form.description, {'attr': {'class': 'form-control-enhanced form-textarea-enhanced', 'rows': '4', 'placeholder': 'Décrivez votre événement en détail...'}}) }}
                                    {{ form_errors(form.description) }}
                                </div>
                            </div>
                            
                            <!-- Section Date et lieu -->
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="fas fa-calendar-alt"></i>
                                    Date et lieu
                                </h3>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group-enhanced">
                                            {{ form_label(form.dateHeure, 'Date et heure') }}
                                            {{ form_widget(form.dateHeure, {'attr': {'class': 'form-control-enhanced'}}) }}
                                            {{ form_errors(form.dateHeure) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group-enhanced">
                                            {{ form_label(form.duree, 'Durée (minutes)') }}
                                            {{ form_widget(form.duree, {'attr': {'class': 'form-control-enhanced', 'placeholder': '60'}}) }}
                                            {{ form_errors(form.duree) }}
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group-enhanced">
                                    {{ form_label(form.salle, 'Salle') }}
                                    {{ form_widget(form.salle, {'attr': {'class': 'form-control-enhanced'}}) }}
                                    {{ form_errors(form.salle) }}
                                </div>
                            </div>
                            
                            <!-- Section Documents -->
                            <div class="form-section">
                                <h3 class="form-section-title">
                                    <i class="fas fa-file-upload"></i>
                                    Documents et fichiers
                                </h3>
                                
                                <div class="file-upload-area" onclick="document.getElementById('{{ form.imageFile.vars.id }}').click()">
                                    <div class="file-upload-icon">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <div class="file-upload-text">
                                        <strong>Cliquez pour sélectionner des fichiers</strong><br>
                                        ou glissez-déposez vos documents ici
                                    </div>
                                    <small class="text-muted">Formats acceptés: PDF, DOC, DOCX, JPG, PNG (Max 10MB)</small>
                                </div>
                                
                                <div class="form-group-enhanced" style="display: none;">
                                    {{ form_widget(form.imageFile, {'attr': {'class': 'form-control-enhanced'}}) }}
                                    {{ form_errors(form.imageFile) }}
                                </div>
                            </div>
                            
                            <!-- Actions -->
                            <div class="form-actions-enhanced">
                                <a href="{{ path('event_show', {'id': event.id}) }}" class="btn-enhanced btn-secondary-enhanced">
                                    <i class="fas fa-eye"></i> Voir l'événement
                                </a>
                                <a href="{{ path('event_list') }}" class="btn-enhanced btn-secondary-enhanced">
                                    <i class="fas fa-list"></i> Liste des événements
                                </a>
                                <button type="submit" class="btn-enhanced btn-primary-enhanced">
                                    <i class="fas fa-save"></i> Enregistrer les modifications
                                </button>
                            </div>
                            
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Gestion du drag & drop pour les fichiers
        const fileUploadArea = document.querySelector('.file-upload-area');
        const fileInput = document.getElementById('{{ form.imageFile.vars.id }}');

        fileUploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            fileUploadArea.classList.add('dragover');
        });

        fileUploadArea.addEventListener('dragleave', () => {
            fileUploadArea.classList.remove('dragover');
        });

        fileUploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            fileUploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                updateFileDisplay(files);
            }
        });

        fileInput.addEventListener('change', (e) => {
            updateFileDisplay(e.target.files);
        });

        function updateFileDisplay(files) {
            const fileUploadText = fileUploadArea.querySelector('.file-upload-text');
            if (files.length > 0) {
                fileUploadText.innerHTML = `<strong>${files.length} fichier(s) sélectionné(s)</strong><br>`;
                for (let i = 0; i < files.length; i++) {
                    fileUploadText.innerHTML += `${files[i].name}<br>`;
                }
            } else {
                fileUploadText.innerHTML = '<strong>Cliquez pour sélectionner des fichiers</strong><br>ou glissez-déposez vos documents ici';
            }
        }

        // Animation des champs au focus
        document.querySelectorAll('.form-control-enhanced').forEach(field => {
            field.addEventListener('focus', function() {
                this.parentElement.style.transform = 'translateY(-2px)';
            });
            
            field.addEventListener('blur', function() {
                this.parentElement.style.transform = 'translateY(0)';
            });
        });
    </script>
{% endblock %}
