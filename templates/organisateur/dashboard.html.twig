{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Organisateur - EventHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        :root {
            /* Schéma de couleurs unifié pour tous les dashboards */
            --primary-color: #6366f1;
            --secondary-color: #8b5cf6;
            --accent-color: #a855f7;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #3b82f6;
            
            /* Gradients unifiés (alignés sur les titres/base) */
            --primary-gradient: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 50%, var(--primary-light) 100%);
            --secondary-gradient: linear-gradient(135deg, #a855f7 0%, #d946ef 100%);
            --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --warning-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            --info-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            
            /* Couleurs de base unifiées */
            --bg-primary: #ffffff;
            --bg-secondary: #f8fafc;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --card-bg: rgba(255, 255, 255, 0.95);
            --border-color: rgba(226, 232, 240, 0.8);
            --shadow: 0 10px 25px rgba(99, 102, 241, 0.1);
            --glass-border: rgba(99, 102, 241, 0.1);
            
            /* Variables spécifiques organisateur */
            --organizer-accent: var(--primary-color);
            --organizer-gradient: var(--primary-gradient);
        }

        body {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-primary);
        }

        .organizer-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header organisateur harmonisé */
        .organizer-hero {
            background: var(--organizer-gradient);
            border-radius: 30px;
            padding: 40px;
            margin-bottom: 40px;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        }

        .organizer-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="50" cy="10" r="0.5" fill="rgba(255,255,255,0.1)"/><circle cx="10" cy="60" r="0.5" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="40" r="0.5" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            opacity: 0.3;
        }

        .hero-content { position: relative; z-index: 2; }

        .hero-avatar {
            width: 120px; height: 120px; background: rgba(255,255,255,0.2);
            border: 4px solid rgba(255,255,255,0.3); border-radius: 50%; display: flex;
            align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 3rem;
            backdrop-filter: blur(20px); animation: float 6s ease-in-out infinite;
        }

        @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

        .hero-title { font-size: 2.5rem; font-weight: 800; margin: 0 0 10px 0; text-shadow: 0 2px 4px rgba(0,0,0,.1); }
        .hero-subtitle { font-size: 1.2rem; opacity: .9; margin: 0 0 30px 0; }

        .hero-stats { display:flex; justify-content:center; gap:40px; flex-wrap:wrap; }
        .hero-stat { text-align:center; background:rgba(255,255,255,.15); padding:20px 30px; border-radius:20px; backdrop-filter: blur(20px); border:1px solid rgba(255,255,255,.2); }
        .hero-stat-number { display:block; font-size:2.5rem; font-weight:800; margin-bottom:5px; }
        .hero-stat-label { font-size:.9rem; opacity:.8; text-transform:uppercase; letter-spacing:1px; }

        /* Section statistiques avancées harmonisées */
        .stats-overview { margin-bottom: 40px; }
        .section-title { font-size:2rem; font-weight:700; margin-bottom:30px; color:var(--text-primary); display:flex; align-items:center; gap:15px; }
        .section-title i { color: var(--organizer-accent); }

        .stats-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); gap:25px; }
        .stat-card { background:var(--card-bg); border:1px solid var(--glass-border); border-radius:25px; padding:30px; box-shadow:var(--shadow); transition:.4s; position:relative; overflow:hidden; }
        .stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:5px; background: var(--organizer-gradient); transform: scaleX(0); transition: transform .4s; }
        .stat-card:hover::before { transform: scaleX(1); }
        .stat-card:hover { transform: translateY(-10px); box-shadow: 0 25px 50px rgba(99,102,241,.2); }

        .stat-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:25px; }
        .stat-icon { width:70px; height:70px; border-radius:20px; background: var(--organizer-gradient); display:flex; align-items:center; justify-content:center; font-size:1.8rem; color:white; }
        .stat-trend { display:flex; align-items:center; gap:8px; padding:10px 15px; border-radius:25px; font-size:.9rem; font-weight:600; }
        .stat-trend.positive { background: rgba(16,185,129,.1); color: var(--success-color); }
        .stat-trend.negative { background: rgba(239,68,68,.1); color: var(--danger-color); }
        .stat-trend.neutral { background: rgba(99,102,241,.1); color: var(--organizer-accent); }

        .stat-content h3 { margin:0 0 20px 0; font-size:1.4rem; font-weight:600; color:var(--text-primary); }
        .stat-number { font-size:3rem; font-weight:800; margin-bottom:15px; background: var(--organizer-gradient); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .stat-content p { margin:0; color:var(--text-secondary); font-size:1rem; line-height:1.6; }

        .stat-progress { margin-top:25px; height:8px; background: var(--bg-secondary); border-radius:4px; overflow:hidden; }
        .progress-bar { height:100%; background: var(--success-gradient); border-radius:4px; transition: width 1.5s ease; position:relative; }
        .progress-bar::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent); animation: shimmer 2s infinite; }
        @keyframes shimmer { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }

        /* Section activité récente harmonisée */
        .activity-section{ margin-bottom:40px; }
        .activity-grid{ display:grid; grid-template-columns:2fr 1fr; gap:30px; }
        .activity-card{ background:var(--card-bg); border:1px solid var(--glass-border); border-radius:25px; padding:30px; box-shadow:var(--shadow); }
        .activity-list{ display:flex; flex-direction:column; gap:20px; }
        .activity-item{ display:flex; align-items:center; gap:20px; padding:20px; background:var(--bg-secondary); border-radius:20px; transition:.3s; }
        .activity-item:hover{ transform: translateX(10px); background: var(--organizer-accent); color:white; }
        .activity-item:hover .activity-content h5, .activity-item:hover .activity-content p{ color:white; }
        .activity-icon{ width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:white; flex-shrink:0; }
        .activity-content{ flex:1; }
        .activity-content h5{ margin:0 0 8px 0; font-size:1.1rem; font-weight:600; color:var(--text-primary); }
        .activity-content p{ margin:0; color:var(--text-secondary); font-size:.95rem; line-height:1.5; }
        .activity-date{ font-size:.85rem; color:var(--text-secondary); font-weight:500; text-align:right; min-width:80px; }
        .activity-item:hover .activity-date{ color: rgba(255,255,255,.8); }

        /* Responsive */
        @media (max-width:1200px){ .activity-grid{ grid-template-columns:1fr; } }
        @media (max-width:768px){ .organizer-container{ padding:15px; } .organizer-hero{ padding:30px 20px; } .hero-title{ font-size:2rem; } .hero-stats{ gap:20px; } .hero-stat{ padding:15px 20px; } .stats-grid{ grid-template-columns:1fr; } }

        /* Notifications toast harmonisées */
        .notification-toast{ position:fixed; top:20px; right:20px; background:white; border:1px solid var(--glass-border); border-radius:15px; padding:15px 20px; box-shadow:var(--shadow); z-index:1000; transform:translateX(400px); transition:transform .3s; max-width:350px; }
        .notification-toast.show{ transform:translateX(0); }
        .notification-toast.success{ border-left:4px solid var(--success-color); }
        .notification-toast.warning{ border-left:4px solid var(--warning-color); }
        .notification-toast.info{ border-left:4px solid var(--info-color); }
        .notification-content{ display:flex; align-items:center; gap:12px; }
        .notification-content i{ font-size:1.2rem; }
        .notification-content i.fa-check-circle{ color:var(--success-color); }
        .notification-content i.fa-exclamation-triangle{ color:var(--warning-color); }
        .notification-content i.fa-info-circle{ color:var(--info-color); }
        .notification-content span{ color:var(--text-primary); font-size:.95rem; font-weight:500; }

        /* Animations */
        .fade-in-up{ animation: fadeInUp .8s ease-out; }
        @keyframes fadeInUp{ from{opacity:0; transform:translateY(30px)} to{opacity:1; transform:translateY(0)} }
        .stagger-1{animation-delay:.1s} .stagger-2{animation-delay:.2s} .stagger-3{animation-delay:.3s} .stagger-4{animation-delay:.4s}
        .organizer-hero{ background-size:200% 200%; animation: gradientShift 8s ease infinite; }
        @keyframes gradientShift{ 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }

        .stat-card,.activity-card{ backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); }
        .performance-indicator{ display:inline-flex; align-items:center; gap:8px; padding:6px 12px; border-radius:20px; font-size:.85rem; font-weight:600; }
        .performance-indicator.excellent{ background:rgba(16,185,129,.1); color:var(--success-color); }
        .performance-indicator.good{ background:rgba(34,197,94,.1); color:#22c55e; }
        .performance-indicator.average{ background:rgba(245,158,11,.1); color:var(--warning-color); }
        .performance-indicator.needs-improvement{ background:rgba(239,68,68,.1); color:var(--danger-color); }
    </style>
{% endblock %}

{% block body %}
<div class="organizer-container">
    <!-- Header organisateur harmonisé -->
    <div class="organizer-hero fade-in-up">
        <div class="hero-content">
            <div class="hero-avatar">
                <i class="fas fa-crown"></i>
            </div>
            <h1 class="hero-title">Tableau de bord Organisateur</h1>
            <p class="hero-subtitle">Gérez vos événements et maximisez l'engagement des participants</p>
            
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">{{ stats.total_events }}</span>
                    <span class="hero-stat-label">Événements</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">{{ stats.total_participants }}</span>
                    <span class="hero-stat-label">Participants</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">{{ stats.upcoming_events }}</span>
                    <span class="hero-stat-label">À venir</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">{{ stats.participation_rate }}%</span>
                    <span class="hero-stat-label">Participation</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section statistiques avancées harmonisées -->
    <div class="stats-overview">
        <h2 class="section-title fade-in-up">
            <i class="fas fa-chart-line"></i>
            Vue d'ensemble des performances
        </h2>
        
        <div class="stats-grid">
            <div class="stat-card fade-in-up stagger-1">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="stat-trend positive">
                        <i class="fas fa-arrow-up"></i> +12%
                    </div>
                </div>
                <div class="stat-content">
                    <h3>Taux de participation</h3>
                    <div class="stat-number">{{ stats.participation_rate }}%</div>
                    <p>Augmentation par rapport au mois dernier</p>
                    <div class="stat-progress">
                        <div class="progress-bar" style="width: {{ stats.participation_rate }}%"></div>
                    </div>
                </div>
            </div>

            <div class="stat-card fade-in-up stagger-2">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-trend positive">
                        <i class="fas fa-arrow-up"></i> +8%
                    </div>
                </div>
                <div class="stat-content">
                    <h3>Nouveaux participants</h3>
                    <div class="stat-number">{{ stats.total_participants }}</div>
                    <p>Croissance de votre communauté</p>
                    <div class="stat-progress">
                        <div class="progress-bar" style="width: 75%"></div>
                    </div>
                </div>
            </div>

            <div class="stat-card fade-in-up stagger-3">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-trend neutral">
                        <i class="fas fa-minus"></i> Stable
                    </div>
                </div>
                <div class="stat-content">
                    <h3>Événements planifiés</h3>
                    <div class="stat-number">{{ stats.upcoming_events }}</div>
                    <p>Prochains événements dans votre agenda</p>
                    <div class="stat-progress">
                        <div class="progress-bar" style="width: 60%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- Section activité récente et widgets -->
    <div class="activity-section">
        <h2 class="section-title fade-in-up">
            <i class="fas fa-activity"></i>
            Activité récente
        </h2>
        
        <div class="activity-grid">
            <!-- Activité récente -->
            <div class="activity-card fade-in-up stagger-1" style="grid-column: 1 / -1;">
                <h3 style="margin-bottom: 25px; color: var(--text-primary); font-size: 1.3rem;">
                    <i class="fas fa-clock" style="color: var(--organizer-accent);"></i>
                    Dernières activités
                </h3>
                
                <div class="activity-list">
                    {% for activity in recent_activity %}
                    <div class="activity-item" data-category="{{ activity.category }}">
                        <div class="activity-icon" style="background: {{ activity.color }};">
                            <i class="fas fa-{{ activity.icon }}"></i>
                        </div>
                        <div class="activity-content">
                            <h5>{{ activity.title }}</h5>
                            <p>{{ activity.description }}</p>
                        </div>
                        <div class="activity-date">
                            {% if activity.date %}
                                {% set now = "now"|date('U') %}
                                {% set eventTime = activity.date|date('U') %}
                                {% set diff = now - eventTime %}
                                {% if diff < 3600 %}
                                    Il y a {{ (diff / 60)|round }} min
                                {% elseif diff < 86400 %}
                                    Il y a {{ (diff / 3600)|round }}h
                                {% else %}
                                    Il y a {{ (diff / 86400)|round }} jours
                                {% endif %}
                            {% else %}
                                Récemment
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>


        </div>
    </div>




</div>

<script>
// Animation d'entrée pour les éléments
const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
        }
    });
}, observerOptions);

// Observer tous les éléments avec animation
document.querySelectorAll('.fade-in-up').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(30px)';
    el.style.transition = 'all 0.8s ease-out';
    observer.observe(el);
});

// Animation des barres de progression
document.addEventListener('DOMContentLoaded', function() {
    const progressBars = document.querySelectorAll('.progress-bar');
    progressBars.forEach(bar => {
        const width = bar.style.width;
        bar.style.width = '0%';
        setTimeout(() => {
            bar.style.width = width;
        }, 500);
    });


});



// Hover effects pour les cartes
document.querySelectorAll('.stat-card').forEach(card => {
    card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-10px) scale(1.02)';
    });
    
    card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
    });
});

// Animation des statistiques du héro
function animateHeroStats() {
    const statNumbers = document.querySelectorAll('.hero-stat-number');
    statNumbers.forEach(stat => {
        const finalValue = parseInt(stat.textContent);
        const duration = 2000;
        const increment = finalValue / (duration / 16);
        let currentValue = 0;
        
        const timer = setInterval(() => {
            currentValue += increment;
            if (currentValue >= finalValue) {
                currentValue = finalValue;
                clearInterval(timer);
            }
            stat.textContent = Math.floor(currentValue);
        }, 16);
    });
}

// Lancer l'animation des stats au chargement
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(animateHeroStats, 500);
});

// Système de notifications en temps réel (simulé)
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `notification-toast ${type}`;
    notification.innerHTML = `
        <div class="notification-content">
            <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
            <span>${message}</span>
        </div>
    `;
    
    document.body.appendChild(notification);
    
    // Animation d'entrée
    setTimeout(() => {
        notification.classList.add('show');
    }, 100);
    
    // Suppression automatique
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => {
            document.body.removeChild(notification);
        }, 300);
    }, 5000);
}

// Exemple d'utilisation des notifications
setTimeout(() => {
    showNotification('Nouveau participant inscrit à votre événement !', 'success');
}, 3000);

setTimeout(() => {
    showNotification('Rappel : Votre événement commence dans 1 heure', 'warning');
}, 8000);
</script>
{% endblock %}