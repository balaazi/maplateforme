{% extends 'base.html.twig' %}

{% block title %}Affecter un utilisateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms-modern.css') }}">
    <style>
        .page-header { text-align: center; margin-bottom: 1.25rem; }
        .page-subtitle { color: #6b7280; }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="page-header">
        <h1 class="display-6 fw-bold mb-1">Affecter un utilisateur</h1>
        <p class="page-subtitle">Département: <strong>{{ departement.nom }}</strong></p>
    </div>

    <div class="form-container">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.user, 'Utilisateur', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.user, {'attr': {'class': 'form-select'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.user) }}</div>
            </div>

            <div class="form-buttons">
                <button class="btn btn-primary"><i class="fas fa-user-check"></i> Affecter</button>
                <a href="{{ path('app_departement_show', {id: departement.id}) }}" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}