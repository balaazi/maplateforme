{% extends 'base.html.twig' %}

{% block title %}Nouveau Département{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms-modern.css') }}">
    <style>
        .page-header { text-align: center; margin-bottom: 1.25rem; }
        .page-subtitle { color: #6b7280; }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="page-header">
        <h1 class="display-6 fw-bold mb-1">Créer un Département</h1>
        <p class="page-subtitle">Renseignez les informations du département</p>
    </div>

    <div class="form-container">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom du département'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.nom) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.code, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.code, {'attr': {'class': 'form-control', 'placeholder': 'Code unique'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.code) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-textarea', 'rows': 4, 'placeholder': 'Description du département'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.description) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.responsable, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.responsable, {'attr': {'class': 'form-control', 'placeholder': 'Responsable'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.responsable) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.emailContact, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.emailContact, {'attr': {'class': 'form-control', 'placeholder': 'Email de contact'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.emailContact) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.telephone) }}</div>
            </div>

            <div class="form-group">
                {{ form_label(form.localisation, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.localisation, {'attr': {'class': 'form-control', 'placeholder': 'Localisation'}}) }}
                <div class="invalid-feedback">{{ form_errors(form.localisation) }}</div>
            </div>

            <div class="form-buttons">
                <button class="btn btn-primary"><i class="fas fa-save"></i> Enregistrer</button>
                <a href="{{ path('app_departement_index') }}" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
    
</div>
{% endblock %}