{% extends 'base.html.twig' %}

{% block title %}Modifier l'Utilisateur - Interface Commune{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-edit-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            margin-top: -90px;
            padding-top: 90px;
        }

        .admin-header {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .admin-title {
            color: white;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .admin-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 1.1rem;
        }

        .form-container {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .form-label {
            color: white;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            color: white;
            padding: 0.75rem 1rem;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.5);
            color: white;
            box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .form-select {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            color: white;
            padding: 0.75rem 1rem;
        }

        .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.5);
            color: white;
            box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
        }

        .form-select option {
            background: #2d3748;
            color: white;
        }

        .btn-submit {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .btn-cancel {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            margin-left: 1rem;
        }

        .btn-cancel:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            color: white;
            text-decoration: none;
        }

        .user-info {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .user-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 2rem;
            margin: 0 auto 1rem;
        }

        .user-name {
            color: white;
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            margin-bottom: 0.5rem;
        }

        .user-email {
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
            margin-bottom: 1rem;
        }

        .user-roles {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .role-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            color: white;
        }

        .role-badge.admin {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
        }

        .role-badge.organisateur {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        .role-badge.participant {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
    </style>
{% endblock %}

{% block body %}
<div class="admin-edit-container">
    <div class="container py-4">
        <!-- En-tête -->
        <div class="admin-header">
            <h1 class="admin-title">
                <i class="fas fa-user-edit me-3"></i>
                Modifier l'Utilisateur
            </h1>
            <p class="admin-subtitle">
                Modifiez les informations de l'utilisateur sélectionné
            </p>
        </div>

        <!-- Informations de l'utilisateur -->
        <div class="user-info">
            <div class="user-avatar">
                {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
            </div>
            <div class="user-name">{{ user.fullName }}</div>
            <div class="user-email">{{ user.email }}</div>
            <div class="user-roles">
                {% for role in user.roles %}
                    {% if role == 'ROLE_ADMIN' %}
                        <span class="role-badge admin">Administrateur</span>
                    {% elseif role == 'ROLE_ORGANISATEUR' %}
                        <span class="role-badge organisateur">Organisateur</span>
                    {% elseif role == 'ROLE_PARTICIPANT' %}
                        <span class="role-badge participant">Participant</span>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <!-- Formulaire d'édition -->
        <div class="form-container">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.roles, 'Rôles', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.roles) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.departement, 'Département', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.departement, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.departement) }}
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.telephone, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.telephone) }}
                    </div>
                </div>

            </div>

            <div class="mb-3">
                {{ form_label(form.specialite, 'Spécialité', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.specialite, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.specialite) }}
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-submit">
                    <i class="fas fa-save me-2"></i>
                    Sauvegarder les Modifications
                </button>
                <a href="{{ path('common_admin_users') }}" class="btn btn-cancel">
                    <i class="fas fa-times me-2"></i>
                    Annuler
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %} 