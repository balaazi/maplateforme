{% extends 'base.html.twig' %}

{% block title %}Statistiques des salles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 25px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 20px 60px rgba(102, 126, 234, 0.4);
        }

        .stats-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: var(--card-gradient);
        }

        .stat-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        }

        .stat-card.primary::before {
            --card-gradient: linear-gradient(90deg, #667eea, #764ba2);
        }

        .stat-card.success::before {
            --card-gradient: linear-gradient(90deg, #48bb78, #38a169);
        }

        .stat-card.warning::before {
            --card-gradient: linear-gradient(90deg, #ed8936, #dd6b20);
        }

        .stat-card.info::before {
            --card-gradient: linear-gradient(90deg, #4299e1, #3182ce);
        }

        .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .stat-icon.primary {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .stat-icon.success {
            background: linear-gradient(135deg, #48bb78, #38a169);
            color: white;
        }

        .stat-icon.warning {
            background: linear-gradient(135deg, #ed8936, #dd6b20);
            color: white;
        }

        .stat-icon.info {
            background: linear-gradient(135deg, #4299e1, #3182ce);
            color: white;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 10px;
            background: var(--card-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 1.1rem;
            color: #4a5568;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .stat-description {
            color: #718096;
            font-size: 0.9rem;
        }

        .charts-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .chart-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .chart-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .usage-table {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .usage-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .usage-item:last-child {
            border-bottom: none;
        }

        .usage-room {
            font-weight: 600;
            color: #2d3748;
        }

        .usage-count {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .progress-ring {
            width: 120px;
            height: 120px;
            margin: 0 auto;
            position: relative;
        }

        .progress-ring circle {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: center;
        }

        .progress-ring .background {
            stroke: #e2e8f0;
        }

        .progress-ring .progress {
            stroke: url(#gradient);
            stroke-dasharray: 283;
            stroke-dashoffset: 283;
            animation: progress 2s ease-in-out forwards;
        }

        @keyframes progress {
            to {
                stroke-dashoffset: calc(283 - (283 * var(--progress)) / 100);
            }
        }

        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            font-weight: 700;
            color: #2d3748;
        }

        .export-section {
            background: #f8fafc;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
        }

        .export-btn {
            background: linear-gradient(135deg, #48bb78, #38a169);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .export-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(72, 187, 120, 0.3);
            color: white;
        }

        @media (max-width: 768px) {
            .charts-section {
                grid-template-columns: 1fr;
            }
            
            .stats-cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .stats-hero {
                padding: 25px;
                text-align: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="stats-hero">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">Statistiques & Analytics</h1>
                <p class="lead mb-0">Tableau de bord complet pour l'analyse de l'utilisation de vos salles</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_salle_index') }}" class="btn btn-light btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>
                    Retour aux salles
                </a>
            </div>
        </div>
    </div>

    <!-- Cartes statistiques principales -->
    <div class="stats-cards">
        <div class="stat-card primary">
            <div class="stat-icon primary">
                <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-number">{{ totalSalles }}</div>
            <div class="stat-label">Total des salles</div>
            <div class="stat-description">Salles enregistrées dans le système</div>
        </div>

        <div class="stat-card success">
            <div class="stat-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-number">{{ sallesActives }}</div>
            <div class="stat-label">Salles actives</div>
            <div class="stat-description">Salles disponibles pour réservation</div>
        </div>

        <div class="stat-card warning">
            <div class="stat-icon warning">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-number">{{ totalReservations }}</div>
            <div class="stat-label">Réservations totales</div>
            <div class="stat-description">Toutes réservations confondues</div>
        </div>

        <div class="stat-card info">
            <div class="stat-icon info">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-number">{{ reservationsAujourdhui }}</div>
            <div class="stat-label">Aujourd'hui</div>
            <div class="stat-description">Réservations en cours aujourd'hui</div>
        </div>
    </div>

    <!-- Graphiques et analyses -->
    <div class="charts-section">
        <div class="chart-card">
            <h3 class="chart-title">
                <i class="fas fa-chart-pie text-primary"></i>
                Taux d'occupation global
            </h3>
            <div class="text-center">
                <svg class="progress-ring" style="--progress: {{ tauxOccupation }}">
                    <defs>
                        <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                    <circle class="background" cx="60" cy="60" r="45"></circle>
                    <circle class="progress" cx="60" cy="60" r="45"></circle>
                </svg>
                <div class="progress-text">{{ tauxOccupation }}%</div>
            </div>
            <p class="text-center mt-3 text-muted">Basé sur les 30 derniers jours</p>
        </div>

        <div class="chart-card">
            <h3 class="chart-title">
                <i class="fas fa-trophy text-warning"></i>
                Salles les plus utilisées
            </h3>
            {% if sallesPlusUtilisees is defined and sallesPlusUtilisees|length > 0 %}
                {% for salle in sallesPlusUtilisees %}
                    <div class="usage-item">
                        <div class="usage-room">{{ salle.salle_nom }}</div>
                        <div class="usage-count">{{ salle.total_reservations }}</div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="text-center text-muted py-4">
                    <i class="fas fa-chart-bar fa-3x mb-3"></i>
                    <p>Aucune donnée d'utilisation disponible</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Répartition par type -->
    {% if repartitionParType is defined and repartitionParType|length > 0 %}
    <div class="usage-table">
        <h3 class="chart-title">
            <i class="fas fa-layer-group text-info"></i>
            Répartition par type de salle
        </h3>
        <div class="row">
            {% for type in repartitionParType %}
                <div class="col-md-4 mb-3">
                    <div class="text-center p-3 border rounded">
                        <h4 class="text-primary">{{ type.count }}</h4>
                        <p class="mb-0">{{ type.type_label }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Section d'export -->
    <div class="export-section">
        <h3 class="mb-3">
            <i class="fas fa-download me-2"></i>
            Exporter les données
        </h3>
        <p class="text-muted mb-4">Téléchargez un rapport détaillé de l'utilisation des salles</p>
        <a href="{{ path('app_salle_stats_export') }}" class="export-btn">
            <i class="fas fa-file-excel"></i>
            Télécharger rapport Excel
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Animation pour les barres de progression
        document.addEventListener('DOMContentLoaded', function() {
            const progressRings = document.querySelectorAll('.progress-ring');
            
            progressRings.forEach(ring => {
                const progress = ring.style.getPropertyValue('--progress');
                const circle = ring.querySelector('.progress');
                
                setTimeout(() => {
                    circle.style.strokeDashoffset = `calc(283 - (283 * ${progress}) / 100)`;
                }, 500);
            });
        });
    </script>
{% endblock %} 