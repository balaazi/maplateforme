{% extends 'base.html.twig' %}

{% block title %}Modifier la réservation{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(120deg, #f6f6fa 60%, #e9d8fd 100%);
        min-height: 100vh;
    }
    .reservation-logo {
        display: block;
        margin: 0 auto 18px auto;
        max-width: 120px;
    }
    .reservation-illustration {
        display: block;
        margin: 0 auto 24px auto;
        max-width: 220px;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(108,46,183,0.07);
    }
    .reservation-form-wrapper {
        max-width: 520px;
        margin: 40px auto 0 auto;
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 6px 32px rgba(108,46,183,0.10), 0 2px 8px rgba(80, 80, 120, 0.08);
        padding: 36px 36px 28px 36px;
        position: relative;
    }
    .reservation-form-wrapper h2 {
        text-align: center;
        margin-bottom: 10px;
        color: #6c2eb7;
        font-weight: 800;
        font-size: 2.1rem;
        letter-spacing: 1px;
    }
    .reservation-form-wrapper p {
        text-align: center;
        color: #7c5ab8;
        margin-bottom: 22px;
        font-size: 1.08rem;
    }
    .reservation-form-wrapper .form-control,
    .reservation-form-wrapper .form-select {
        border-radius: 10px;
        border: 1.5px solid #d1d5db;
        margin-bottom: 20px;
        padding: 12px 14px;
        font-size: 1.05rem;
        background: #f9f9fb;
        transition: border 0.2s;
    }
    .reservation-form-wrapper .form-control:focus,
    .reservation-form-wrapper .form-select:focus {
        border-color: #6c2eb7;
        box-shadow: 0 0 0 2px #e9d8fd;
        background: #fff;
    }
    .reservation-form-wrapper .btn-primary {
        background: linear-gradient(90deg, #6c2eb7 60%, #a084e8 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 32px;
        font-weight: 700;
        font-size: 1.15rem;
        margin-right: 12px;
        transition: background 0.2s;
        box-shadow: 0 2px 8px rgba(108,46,183,0.08);
    }
    .reservation-form-wrapper .btn-primary:hover {
        background: #4b1c7a;
    }
    .reservation-form-wrapper .btn-outline-secondary {
        border-radius: 10px;
        padding: 12px 32px;
        font-weight: 600;
        font-size: 1.1rem;
        border: 1.5px solid #c3aed6;
        color: #6c2eb7;
        background: #f6f6fa;
        transition: background 0.2s, color 0.2s;
    }
    .reservation-form-wrapper .btn-outline-secondary:hover {
        background: #e9d8fd;
        color: #4b1c7a;
    }
    .reservation-form-wrapper .alert {
        border-radius: 10px;
        font-size: 1.05rem;
        margin-bottom: 18px;
        box-shadow: 0 1px 6px rgba(108,46,183,0.07);
    }
    @media (max-width: 600px) {
        .reservation-form-wrapper {
            padding: 18px 6vw 18px 6vw;
        }
        .reservation-illustration {
            max-width: 100%;
        }
    }
</style>

<div class="container mt-4">
    <div class="reservation-form-wrapper">
        {# Logo supprimé ici #}

        <h2>Modifier la réservation</h2>
        <p>
            Modifiez les informations de votre réservation puis cliquez sur <b>Enregistrer les modifications</b>.<br>
            <span style="font-size:0.97em;color:#b197fc;">Tous les champs sont importants pour garantir la bonne gestion de votre salle.</span>
        </p>

        {# Affichage des messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form) }}
            <div class="row">
                <div class="col-12">
                    {{ form_widget(form) }}
                </div>
            </div>
            <div class="d-flex justify-content-center mt-4">
                <button class="btn btn-primary me-2 px-4 py-2" style="font-size:1.1rem;">
                    <i class="fas fa-save"></i> Enregistrer les modifications
                </button>
                <a href="{{ path('app_salle_disponibilite', {'id': reservation.salle.id}) }}" class="btn btn-outline-secondary px-4 py-2" style="font-size:1.1rem;">
                    <i class="fas fa-arrow-left"></i> Retour au planning
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %} 