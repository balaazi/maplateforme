{% extends 'base.html.twig' %}

{% block title %}Dashboard Participant - EventHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --warning-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --info-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --danger-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --purple-gradient: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
            --ocean-gradient: linear-gradient(135deg, #0984e3 0%, #74b9ff 100%);
            --forest-gradient: linear-gradient(135deg, #00b894 0%, #55efc4 100%);
            --sunset-gradient: linear-gradient(135deg, #e17055 0%, #fdcb6e 100%);
            --cosmic-gradient: linear-gradient(135deg, #2d3436 0%, #636e72 100%);
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
            --text-primary: #2d3748;
            --text-secondary: #718096;
            --shadow-light: 0 10px 40px rgba(0, 0, 0, 0.08);
            --shadow-medium: 0 20px 60px rgba(0, 0, 0, 0.12);
            --shadow-heavy: 0 30px 80px rgba(0, 0, 0, 0.16);
            --border-radius: 25px;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8f9fa;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .participant-container {
            background: #f8f9fa;
            min-height: 100vh;
            margin-top: -90px;
            padding-top: 90px;
            position: relative;
            overflow: hidden;
        }



        /* En-tête ultra-moderne */
        .participant-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            backdrop-filter: blur(40px);
            color: white;
            padding: 3.5rem 2.5rem;
            border-radius: 30px;
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-heavy);
            border: 1px solid rgba(255, 255, 255, 0.2);
            animation: slideInFromTop 1s ease-out;
        }

        .participant-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #ffffff, rgba(255,255,255,0.7), #ffffff);
            animation: shimmer 3s ease-in-out infinite;
        }

        .participant-header::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.1), transparent);
            animation: rotate 20s linear infinite;
            pointer-events: none;
        }

        @keyframes shimmer {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .welcome-content {
            position: relative;
            z-index: 2;
        }

        .user-avatar {
            background: rgba(255, 255, 255, 0.25);
            width: 100px;
            height: 100px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            backdrop-filter: blur(20px);
            border: 3px solid rgba(255, 255, 255, 0.4);
            font-size: 2.5rem;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            position: relative;
            overflow: hidden;
        }

        .user-avatar::before {
            content: '';
            position: absolute;
            inset: 0;
            padding: 3px;
            background: linear-gradient(45deg, #ffffff, transparent, #ffffff);
            border-radius: inherit;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: subtract;
            animation: borderRotate 3s linear infinite;
        }

        @keyframes borderRotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .user-avatar:hover {
            transform: scale(1.1) rotate(10deg);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .participant-header h1 {
            font-size: 3.2rem;
            font-weight: 900;
            margin: 0 0 1rem 0;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            background: linear-gradient(45deg, #fff, #f0f8ff, #fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: textGlow 2s ease-in-out infinite alternate;
        }

        @keyframes textGlow {
            0% { filter: drop-shadow(0 0 5px rgba(255,255,255,0.5)); }
            100% { filter: drop-shadow(0 0 20px rgba(255,255,255,0.8)); }
        }

        .participant-header p {
            margin: 0 0 2rem 0;
            opacity: 0.95;
            font-size: 1.4rem;
            font-weight: 400;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        /* Mini statistiques redesignées */
        .welcome-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .welcome-stat {
            text-align: center;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 20px;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .welcome-stat::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.6s ease;
        }

        .welcome-stat:hover::before {
            left: 100%;
        }

        .welcome-stat:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
        }

        .welcome-stat-number {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            color: #ffffff;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .welcome-stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Grille des cartes statistiques premium */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2.5rem;
            margin-bottom: 4rem;
            padding: 0 1rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 30px;
            padding: 3rem;
            position: relative;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: var(--shadow-light);
            cursor: pointer;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            border-radius: 30px 30px 0 0;
            transition: height 0.4s ease;
        }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: radial-gradient(circle, rgba(102,126,234,0.08) 0%, transparent 70%);
            transition: all 0.8s ease;
            transform: translate(-50%, -50%);
            border-radius: 50%;
        }

        .stat-card:hover::before {
            height: 100%;
            opacity: 0.08;
        }

        .stat-card:hover::after {
            width: 400px;
            height: 400px;
        }

        .stat-card.events::before { background: var(--primary-gradient); }
        .stat-card.notifications::before { background: var(--warning-gradient); }
        .stat-card.documents::before { background: var(--info-gradient); }

        .stat-card:hover {
            transform: translateY(-20px) scale(1.03);
            box-shadow: var(--shadow-heavy);
        }

        .stat-icon {
            width: 85px;
            height: 85px;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            color: white;
            font-size: 2.2rem;
            position: relative;
            z-index: 2;
            transition: all 0.4s ease;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .stat-icon.events { background: var(--primary-gradient); }
        .stat-icon.notifications { background: var(--warning-gradient); }
        .stat-icon.documents { background: var(--info-gradient); }

        .stat-card:hover .stat-icon {
            transform: scale(1.15) rotate(15deg);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .stat-number {
            font-size: 4rem;
            font-weight: 900;
            color: var(--text-primary);
            margin-bottom: 1rem;
            position: relative;
            z-index: 2;
            font-family: 'Inter', sans-serif;
        }

        .stat-label {
            color: var(--text-primary);
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            z-index: 2;
        }

        .stat-description {
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 2.5rem;
            position: relative;
            z-index: 2;
        }

        /* Boutons d'action premium */
        .btn-action {
            background: var(--primary-gradient);
            border: none;
            color: white;
            padding: 1.2rem 2.5rem;
            border-radius: 15px;
            font-weight: 700;
            transition: all 0.4s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 1rem;
            font-size: 1rem;
            position: relative;
            z-index: 2;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 25px rgba(102,126,234,0.3);
        }

        .btn-action::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.6s ease;
        }

        .btn-action:hover::before {
            left: 100%;
        }

        .btn-action:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 15px 40px rgba(102,126,234,0.5);
            color: white;
            text-decoration: none;
        }

        .btn-action.warning {
            background: var(--warning-gradient);
            box-shadow: 0 8px 25px rgba(240,147,251,0.3);
        }

        .btn-action.warning:hover {
            box-shadow: 0 15px 40px rgba(240,147,251,0.5);
        }

        .btn-action.info {
            background: var(--info-gradient);
            box-shadow: 0 8px 25px rgba(79,172,254,0.3);
        }

        .btn-action.info:hover {
            box-shadow: 0 15px 40px rgba(79,172,254,0.5);
        }

        /* Section activité récente ultra-moderne */
        .activity-section {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 35px;
            box-shadow: var(--shadow-medium);
            overflow: hidden;
            position: relative;
            max-width: 1000px;
            margin: 0 auto 2rem auto;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .activity-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: var(--forest-gradient);
        }

        .section-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 3rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background: var(--forest-gradient);
            border-radius: 4px;
        }

        .section-header h3 {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .icon-wrapper {
            background: var(--forest-gradient);
            width: 60px;
            height: 60px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 10px 30px rgba(0,184,148,0.3);
            transition: all 0.4s ease;
            font-size: 1.5rem;
        }

        .section-header:hover .icon-wrapper {
            transform: scale(1.15) rotate(15deg);
            box-shadow: 0 15px 40px rgba(0,184,148,0.4);
        }

        .section-content {
            padding: 3.5rem;
        }

        /* Timeline ultra-moderne */
        .activity-timeline {
            position: relative;
            padding-left: 3rem;
        }

        .activity-timeline::before {
            content: '';
            position: absolute;
            left: 25px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--forest-gradient);
            border-radius: 4px;
        }

        .timeline-item {
            display: flex;
            gap: 2rem;
            margin-bottom: 3rem;
            position: relative;
            padding: 2rem;
            background: rgba(0,184,148,0.02);
            border-radius: 20px;
            transition: all 0.4s ease;
            border-left: 4px solid transparent;
            border-image: linear-gradient(135deg, #00b894, #55efc4) 1;
        }

        .timeline-item:hover {
            background: rgba(0,184,148,0.05);
            transform: translateX(15px);
            box-shadow: 0 10px 30px rgba(0,184,148,0.1);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -3.2rem;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            background: var(--forest-gradient);
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 6px 20px rgba(0,184,148,0.3);
            transition: all 0.3s ease;
        }

        .timeline-item:hover::before {
            transform: translateY(-50%) scale(1.2);
            box-shadow: 0 8px 25px rgba(0,184,148,0.4);
        }

        .timeline-icon {
            background: var(--forest-gradient);
            width: 50px;
            height: 50px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            flex-shrink: 0;
            box-shadow: 0 8px 25px rgba(0,184,148,0.3);
            transition: all 0.4s ease;
        }

        .timeline-item:hover .timeline-icon {
            transform: scale(1.15) rotate(20deg);
            box-shadow: 0 12px 35px rgba(0,184,148,0.4);
        }

        .timeline-content h5 {
            margin: 0 0 0.75rem 0;
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-primary);
        }

        .timeline-content p {
            margin: 0 0 1rem 0;
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.6;
        }

        .timeline-time {
            color: #95a5a6;
            font-size: 0.9rem;
            font-weight: 600;
            background: rgba(149,165,166,0.15);
            padding: 0.5rem 1rem;
            border-radius: 25px;
            display: inline-block;
        }

        /* Animations */
        @keyframes slideInFromTop {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            opacity: 0;
            transform: translateY(40px);
            animation: fadeInUp 0.8s ease-out forwards;
        }

        .fade-in:nth-child(1) { animation-delay: 0.1s; }
        .fade-in:nth-child(2) { animation-delay: 0.2s; }
        .fade-in:nth-child(3) { animation-delay: 0.3s; }
        .fade-in:nth-child(4) { animation-delay: 0.4s; }

        .pulse-animation {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.05); }
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .participant-container {
                padding: 1rem;
            }

            .participant-header {
                padding: 2.5rem 2rem;
                border-radius: 25px;
            }

            .participant-header h1 {
                font-size: 2.5rem;
            }

            .user-avatar {
                width: 80px;
                height: 80px;
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .stat-card {
                padding: 2.5rem;
            }

            .stat-number {
                font-size: 3rem;
            }

            .welcome-stats {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .section-content {
                padding: 2.5rem;
            }

            .activity-timeline {
                padding-left: 2rem;
            }

            .timeline-item {
                padding: 1.5rem;
                margin-bottom: 2rem;
            }

            .timeline-item::before {
                left: -2.2rem;
            }
        }

        /* Effets de brillance premium */
        .shine-effect {
            position: relative;
            overflow: hidden;
        }

        .shine-effect::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(255, 255, 255, 0.3) 50%,
                transparent 70%
            );
            transform: rotate(45deg);
            animation: shine 4s infinite;
        }

        @keyframes shine {
            0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="participant-container">
        <div class="container-fluid px-4">
            <!-- En-tête participant ultra-moderne -->
            <div class="participant-header shine-effect">
                <div class="d-flex align-items-center justify-content-between flex-wrap">
                    <div class="welcome-content">
                        <div class="user-avatar">
                            <i class="fas fa-user-astronaut"></i>
                        </div>
                        <h1>🎉 Bienvenue {{ app.user ? app.user.prenom : 'Participant' }} !</h1>
                        <p>Votre espace personnel ultra-moderne pour gérer vos événements et participations en toute simplicité</p>
                        
                        <!-- Mini statistiques redesignées -->
                        <div class="welcome-stats">
                            <div class="welcome-stat shine-effect">
                                <div class="welcome-stat-number" data-target="8">0</div>
                                <div class="welcome-stat-label">Événements</div>
                            </div>
                            <div class="welcome-stat shine-effect">
                                <div class="welcome-stat-number" data-target="{{ unreadNotificationsCount ?? 3 }}">0</div>
                                <div class="welcome-stat-label">Notifications</div>
                            </div>
                            <div class="welcome-stat shine-effect">
                                <div class="welcome-stat-number" data-target="12">0</div>
                                <div class="welcome-stat-label">Documents</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cartes statistiques premium -->
            <div class="stats-grid">
                <div class="stat-card events fade-in shine-effect">
                    <div class="stat-icon events">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <div class="stat-number pulse-animation" data-target="8">0</div>
                    <div class="stat-label">Mes Événements</div>
                    <div class="stat-description">Découvrez et gérez vos participations aux événements les plus passionnants organisés pour vous</div>
                    <a href="{{ path('participant_events') }}" class="btn-action">
                        <i class="fas fa-arrow-right"></i>
                        Explorer
                    </a>
                </div>
                
                <div class="stat-card notifications fade-in shine-effect">
                    <div class="stat-icon notifications">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="stat-number pulse-animation" data-target="{{ unreadNotificationsCount ?? 3 }}">0</div>
                    <div class="stat-label">Notifications</div>
                    <div class="stat-description">Restez connecté avec les dernières mises à jour, rappels et messages importants de vos organisateurs</div>
                    <a href="{{ path('participant_notifications') }}" class="btn-action warning">
                        <i class="fas fa-bell"></i>
                        Consulter
                    </a>
                </div>
                
                <div class="stat-card documents fade-in shine-effect">
                    <div class="stat-icon documents">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <div class="stat-number pulse-animation" data-target="12">0</div>
                    <div class="stat-label">Documents</div>
                    <div class="stat-description">Accédez instantanément aux documents partagés, ressources et fichiers importants de vos événements</div>
                    <a href="{{ path('participant_documents') }}" class="btn-action info">
                        <i class="fas fa-cloud-download-alt"></i>
                        Télécharger
                    </a>
                </div>
            </div>

            <!-- Section activité récente ultra-moderne -->
            <div class="activity-section fade-in shine-effect">
                <div class="section-header">
                    <h3>
                        <div class="icon-wrapper">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        Activité récente
                    </h3>
                </div>
                
                <div class="section-content">
                    <div class="activity-timeline">
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="timeline-content">
                                <h5>🎯 Présence confirmée</h5>
                                <p>Vous avez confirmé votre participation à la formation sécurité informatique. Merci de votre engagement !</p>
                                <div class="timeline-time">Il y a 2 heures</div>
                            </div>
                        </div>
                        
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="timeline-content">
                                <h5>📅 Nouvel événement ajouté</h5>
                                <p>Invitation reçue pour la réunion stratégique équipe projet innovant. Découvrez les détails maintenant !</p>
                                <div class="timeline-time">Hier à 14h30</div>
                            </div>
                        </div>
                        
                        <div class="timeline-item">
                            <div class="timeline-icon">
                                <i class="fas fa-download"></i>
