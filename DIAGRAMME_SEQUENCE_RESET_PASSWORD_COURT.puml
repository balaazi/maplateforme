@startuml Reset_Password_Court
!theme plain
skinparam backgroundColor #FFFFFF

title Reset Password - EventHub

actor "👤 U" as U
participant "🌐 Nav" as B
participant "🔑 Reset" as RC
participant "📧 Mailer" as M
participant "📊 Repo" as R
database "🗄️ DB" as DB

U -> B : /reset-password
B -> RC : GET
RC -> B : render form
B --> U : Formulaire

U -> B : Email
B -> RC : POST email
RC -> R : findUser(email)
R -> DB : SELECT
DB --> R : User

alt User trouvé
    RC -> RC : generateToken()
    RC -> M : sendEmail(token)
    M --> RC : OK
    RC -> B : Redirect(confirm)
    B --> U : Confirmation
else User non trouvé
    B --> U : Confirmation
end

U -> B : Clic lien email
B -> RC : GET /reset/{token}
RC -> RC : validateToken()
RC -> B : render reset form
B --> U : Nouveau mot de passe

U -> B : Nouveau pwd
B -> RC : POST
RC -> R : updatePassword()
R -> DB : UPDATE
DB --> R : OK
RC -> B : Redirect(home)
B --> U : Accueil

@enduml
